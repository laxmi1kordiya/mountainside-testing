{% comment %}
  @param layout {String}
    Layout type

  @param is_product_modal {Bool}
    Is the snippet being loaded in a QuickShop

  @param hide_description {Bool}
    If true, hide the product description
{% endcomment %}

{% assign enable_social_sharing = settings.product_social_sharing %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign selected_image = selected_variant.image | default: product.featured_image %}
{% assign compare_at_price = selected_variant.compare_at_price %}
{% assign price = selected_variant.price %}
{% assign sku = selected_variant.sku %}
{% assign product_available = product.available %}

{% if onboarding %}
  {% assign compare_at_price = 2999 %}
  {% assign price = 1999 %}
{% endif %}

{% assign on_sale = false %}
{% if compare_at_price > price %}
  {% assign on_sale = true %}
{% endif %}

{% comment %} Calculate total inventory quantity {% endcomment %}
{% assign total_inventory = 0 %}
{% for variant in product.variants %}
  {% if variant.inventory_management == 'shopify' and variant.inventory_quantity %}
    {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
  {% endif %}
{% endfor %}

{%
  include 'consistent-savings',
  variants: product.variants,
  on_sale: on_sale
%}

{%- capture share_buttons -%}
  {% assign social_image = false %}
  {% if product.featured_image %}
    {% assign social_image = product.featured_image | img_url: '1024x' %}
  {% endif %}
  {% assign social_url = shop.url | append: product.url %}
  {%-
    include 'share-buttons',
    snippet_title: 'general.share_buttons.title',
    social_image: social_image,
    social_title: product.title,
    social_url: social_url
  -%}
{%- endcapture  -%}

<article class="product--outer">
  {% comment %}
    Product slideshow, never moves
  {% endcomment %}
  <div class="product-gallery" data-product-gallery>
    {%
      include 'product-gallery',
      selected_image: selected_image,
      is_product_modal: is_product_modal,
      onboarding: onboarding
    %}
  </div>
  <div class="product-main">
    <div class="product-details" data-product-details>
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'title' %}
            <div {{ block.shopify_attributes }}>
              {% if is_product_modal %}
                <h2 class="product-title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h2>
              {% else %}
                {% if template == 'index' %}
                  <h2 class="product-title">
                {% else %}
                  <h1 class="product-title">
                {% endif %}
                  {% unless onboarding %}
                    {{ product.title }}
                  {% else %}
                    {{ 'onboarding.product.title' | t }}
                  {% endunless %}
                {% if template == 'index' %}
                  </h2>
                {% else %}
                  </h1>
                {% endif %}
              {% endif %}
            </div>

          {% when 'subheading' %}
            {% include 'product-subheading', block: block %}

          {% when 'vendor' %}
            <div class="product-vendor-sku-row">
              {% if settings.product_show_vendor and product.vendor != blank or onboarding %}
                <div class="product-vendor" {{ block.shopify_attributes }}>
                  {% unless onboarding %}
                    {%- capture vendor_link -%}
                      {{ product.vendor | link_to_vendor }}
                    {%- endcapture -%}
                    {{ 'product.general.by_vendor_html' | t: vendor_link: vendor_link }}
                  {% else %}
                    {{ 'onboarding.product.by_vendor' | t }}
                  {% endunless %}
                </div>
              {% endif %}

          {% when 'judge_me' %}
            </div>
            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" {{ block.shopify_attributes }}>
              {{ product.metafields.judgeme.badge }}
            </div>

          {% when 'rating' %}
            {% if settings.product_ratings_reviews %}
              <div class="product-ratings" {{ block.shopify_attributes }}>
                <span class="shopify-product-reviews-badge" data-id="{{ product.id }}">
                  <span class="spr-badge">
                    <span class="spr-starrating spr-badge-starrating">
                      <i class="spr-icon spr-icon-star-empty"></i>
                      <i class="spr-icon spr-icon-star-empty"></i>
                      <i class="spr-icon spr-icon-star-empty"></i>
                      <i class="spr-icon spr-icon-star-empty"></i>
                      <i class="spr-icon spr-icon-star-empty"></i>
                    </span>
                  </span>
                </span>
              </div>
            {% endif %}

          {% when 'price' %}
            <div class="product-pricing" aria-live="polite" {{ block.shopify_attributes }}>
              {%
                include 'product-badge',
                class_root: 'product',
                product_available: product_available,
                on_sale: on_sale,
                price: price,
                compare_at_price: compare_at_price,
                show_saved: true,
                inventory_quantity: total_inventory
              %}
              {%
                include 'product-price',
                class_root: 'product',
                price: price,
                price_varies: false,
                compare_at_price: compare_at_price,
                compare_at_price_varies: false,
                on_sale: on_sale,
                emphasize_price: false,
                show_original: true
              %}
            </div>

          {% when 'sku' %}
              {% if settings.product_show_sku == true %}
                {% unless onboarding %}
                  <div
                    class="product-sku {% if sku == empty %}product-sku--empty{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ 'product.general.sku_html' | t: sku: sku | strip_newlines }}
                  </div>
                {% endunless %}
              {% endif %}
            </div>

          {% when 'form' %}
            </div>
            <div class="product-form--regular" data-product-form-regular {{ block.shopify_attributes }}>
              <div data-product-form-area>
                {% if is_product_modal %}
                  <div data-product-quickshop-message class="product-message--container"></div>
                {% endif %}
                {% unless onboarding %}
                  {%
                    include 'product-form',
                    product: product,
                    selected_variant: selected_variant
                  %}
                {% endunless %}
                {% if hide_description %}
                  <a href="{{ product.url }}" class="product-link">
                    {{ 'product.buttons.view_details' | t }}
                  </a>
                {% endif %}
              </div>
            </div>
            <div class="product-details product-details--continued" data-product-details>

          {% when 'description' %}
            {% unless product.description == blank or hide_description %}
              <div class="product-description rte" data-product-description {{ block.shopify_attributes }}>
                {{ product.description | replace: 'href="http', 'href="https' }}
              </div>
            {% endunless %}

          {% when 'share' %}
            {% if enable_social_sharing and is_product_modal == false %}
              <div {{ block.shopify_attributes }}>
                {{ share_buttons | strip_newlines }}
              </div>
            {% endif %}

          {% when 'icon_features' %}
            {% include 'product-icon-features', block: block %}

          {% when 'icon_row' %}
            {% include 'product-icon-row', block: block %}

          {% when 'shipping_info' %}
            <div class="product-shipping-mobile">
              {% include 'product-shipping-info', block: block %}
            </div>

          {% when 'discount_banner' %}
            {% include 'product-discount-banner', block: block %}

          {% when 'refund_policy' %}
            <div class="product-refund-mobile">
              {% include 'product-refund-policy', block: block %}
            </div>

          {% when 'richtext' %}
            {% if block.settings.content != blank %}
              <div class="product-block product-block--richtext rte" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>
            {% endif %}

          {% when '@app' %}
            <div class="product-app">
              {% render block %}
            </div>

        {% endcase %}
      {% endfor %}
    </div>

    {% comment %}
      Fallback: if no blocks defined (e.g. QuickShop modal), show share buttons
    {% endcomment %}
    {% if enable_social_sharing and is_product_modal %}
      {{ share_buttons | strip_newlines }}
    {% endif %}
  </div>

  {% comment %}
    If is a 3 column layout, the form will move here at $bp-large (layout.isBreakpoint('L'))
  {% endcomment %}
  {% if layout == 'layout--three-col' %}
    <div class="product-form--alt" data-product-form-alt>
      <div class="product-pricing product-pricing-sidebar" aria-live="polite">
        {%
          include 'product-badge',
          class_root: 'product',
          product_available: product_available,
          on_sale: on_sale,
          price: price,
          compare_at_price: compare_at_price,
          show_saved: true,
          inventory_quantity: total_inventory
        %}
        {%
          include 'product-price',
          class_root: 'product',
          price: price,
          price_varies: false,
          compare_at_price: compare_at_price,
          compare_at_price_varies: false,
          on_sale: on_sale,
          emphasize_price: false,
          show_original: true
        %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'shipping_info' %}
          <div class="product-shipping-sidebar">
            {% include 'product-shipping-info', block: block %}
          </div>
        {% endif %}
        {% if block.type == 'refund_policy' %}
          <div class="product-refund-sidebar">
            {% include 'product-refund-policy', block: block %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <script>
    (function() {
      var sidebarPricing = document.querySelector('.product-pricing-sidebar');
      if (!sidebarPricing) return;

      var format = {{ shop.money_format | json }};

      function updateSidebar(variant) {
        if (!variant) return;

        var hasCompare = variant.compare_at_price && variant.compare_at_price > variant.price;

        // Price
        var priceEls = sidebarPricing.querySelectorAll('[data-price] .money');
        for (var i = 0; i < priceEls.length; i++) {
          priceEls[i].textContent = Shopify.formatMoney(variant.price, format);
        }

        // Compare at price
        var compareWraps = sidebarPricing.querySelectorAll('[data-price-compare-at]');
        for (var j = 0; j < compareWraps.length; j++) {
          if (hasCompare) {
            compareWraps[j].classList.add('visible');
          } else {
            compareWraps[j].classList.remove('visible');
          }
        }
        var compareMoney = sidebarPricing.querySelectorAll('[data-price-compare-at] .money');
        for (var k = 0; k < compareMoney.length; k++) {
          compareMoney[k].textContent = hasCompare ? Shopify.formatMoney(variant.compare_at_price, format) : '';
        }

        // Badge
        var saved = hasCompare ? variant.compare_at_price - variant.price : 0;
        var badges = sidebarPricing.querySelectorAll('[data-badge-sales]');
        for (var b = 0; b < badges.length; b++) {
          badges[b].style.display = saved > 0 ? '' : 'none';
        }
        var pctEls = sidebarPricing.querySelectorAll('[data-price-percent-saved]');
        for (var p = 0; p < pctEls.length; p++) {
          pctEls[p].textContent = saved > 0 ? Math.round(saved * 100 / variant.compare_at_price) : '';
        }
        var moneyEls = sidebarPricing.querySelectorAll('[data-price-money-saved]');
        for (var m = 0; m < moneyEls.length; m++) {
          moneyEls[m].textContent = saved > 0 ? Shopify.formatMoney(saved, format) : '';
        }
      }

      // Listen for the variantChange event
      document.addEventListener('variantChange', function(e) {
        updateSidebar(e.detail.variant);
      });

      // Also listen for the native Shopify select change as fallback
      var variantSelect = document.querySelector('[data-product-form] [data-variants]');
      if (variantSelect) {
        variantSelect.addEventListener('change', function() {
          var productJson = document.querySelector('[data-section-type="static-product"][data-section-data]');
          if (!productJson) return;
          try {
            var data = JSON.parse(productJson.textContent);
            var product = data.product;
            if (!product || !product.variants) return;
            var selectedId = parseInt(variantSelect.value, 10);
            for (var v = 0; v < product.variants.length; v++) {
              if (product.variants[v].id === selectedId) {
                updateSidebar(product.variants[v]);
                break;
              }
            }
          } catch(err) {}
        });
      }
    })();
    </script>
  {% endif %}
</article>
