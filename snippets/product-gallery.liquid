{%- capture classes -%}
  product-gallery--slider
  {% if product.images.size > 0 %}
    product-gallery--has-images
    product-gallery--style-{{ settings.product_slideshow_style }}
  {% endif %}
{%- endcapture -%}

<div
  class="{{ classes | strip_newlines }}"
  data-product-slider
  aria-label="{{ product.title }} image. Click or Scroll to Zoom."
>
  {% if product.images.size > 0 %}
    {% for image in product.images %}
      {% assign is_video = false %}

      {%
        if image.alt contains 'vimeo'
        or image.alt contains 'youtube'
        or image.alt contains 'youtu.be'
      %}
        {% assign is_video = true %}
      {% endif %}

      <figure
        class="
          product-gallery--image
          {% if selected_image == image %}
          image--selected
          {% endif %}
        "
        data-product-image="{{ image.id }}"
        data-product-image-index="{{ forloop.index0 }}"
        {% if is_video %}
          data-product-image-video
        {% else %}
          data-product-image-zoom
        {% endif %}
        tabindex="-1"
        {% if selected_image != image %}
          aria-hidden="true"
        {% endif %}
      >
        <div
          class="product-galley--image-background"
          {% if settings.product_slideshow_style contains 'cropped' and is_video == false %}
            {%
              include 'rimg',
              img: image,
              size: 'x700',
              lazy: true,
              background: true,
              attr: 'fetchpriority="high"'
            %}
          {% endif %}
          data-image="{{ image | img_url: '1800x1800' }}"
        >
          {% if is_video %}
            <div class="product-galley--video-container">
              {%
                include 'video',
                slideshow: true,
                url: image.alt,
                aspect_ratio: '16-9',
              %}

              {%
                include 'rimg',
                img: image,
                class: 'product-gallery--video-image'
                size: '1800x1000',
                lazy: true,
                canvas: true
              %}
            </div>
          {% else %}
            {% if settings.enable_image_zoom %}
              <div class="product-galley--zoom-instructions">
                <div class="product-galley--instruction click">
                  {% include 'icon-library', id: 'icon-zoom' %}
                  {{ 'product.general.zoom' | t }}
                </div>

                <div class="product-galley--instruction tap">
                  {% include 'icon-library', id: 'icon-tap' %}
                  {{ 'product.general.zoomTap' | t }}
                </div>

              {% comment %}
                  <div class="product-galley--instruction mobile">
                    {% include 'icon-library', id: 'icon-tap' %}
                    {{ 'product.general.zoomTapMobile' | t }}
                  </div>
                {% endcomment %}
              </div>
            {% endif %}

            {% if selected_image == image %}
              {%- comment -%} First image: render as plain <img> for LCP discoverability {%- endcomment -%}
              <img
                src="{{ image | img_url: 'x700' }}"
                srcset="{{ image | img_url: 'x700' }} 1x, {{ image | img_url: 'x1400' }} 2x"
                alt="{{ image.alt | escape | default: product.title }}"
                fetchpriority="high"
                loading="eager"
                decoding="async"
                class="product-gallery--image-lcp"
              >
            {% else %}
              {%
                include 'rimg',
                img: image,
                size: 'x700',
                lazy: true,
                canvas: true
              %}
            {% endif %}
          {% endif %}
        </div>
      </figure>
    {% endfor %}
  {% else %}
    <figure class="product-gallery--image product-gallery--image-placeholder">
      {% unless onboarding %}
        {{ 'image' | placeholder_svg_tag: 'placeholder--image' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder--image' }}
      {% endunless %}
    </figure>
  {% endif %}
</div>

{% if product.images.size > 0 %}
  <div class="product-gallery--navigation-wrapper">
    <button
      class="product-gallery--nav-arrow product-gallery--nav-arrow-left"
      type="button"
      aria-label="Scroll thumbnails left"
      data-thumbnail-arrow="left"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div
      class="product-gallery--navigation"
      data-product-slider-pagination
      data-thumbnail-scroll-container
      aria-label="{{ 'general.accessibility.nav_product_thumbnails' | t }}"
    >
      {% for image in product.images %}
        {% assign is_video = false %}

        {% if image.alt != blank %}
          {% if image.alt contains 'vimeo' or image.alt contains 'youtube' %}
            {% assign is_video = true %}
          {% endif %}
        {% endif %}

        <button
          class="product-gallery--thumbnail-trigger {% if selected_image == image %}thumbnail--selected{% endif %}"
          data-product-thumbnail="{{ forloop.index0 }}"
          type="button"
        >
          <span class="product-gallery--thumbnail-span" tabindex="-1">
            {% if is_video %}
              {% include 'icon-library', id: 'icon-play' %}
              {%
                include 'rimg',
                class: 'product-gallery--thumbnail',
                img: image,
                size: 'x47',
                alt: 'Product video thumbnail',
              %}
            {% else %}
              {%
                include 'rimg',
                class: 'product-gallery--thumbnail',
                img: image,
                size: 'x47',
              %}
            {% endif %}
          </span>
        </button>
      {% endfor %}
    </div>

    <button
      class="product-gallery--nav-arrow product-gallery--nav-arrow-right"
      type="button"
      aria-label="Scroll thumbnails right"
      data-thumbnail-arrow="right"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
{% endif %}

{% if product.images.size > 0 %}
  <div
    class="product-gallery--overlay"
    data-pixelzoom-overlay
  >
    <div
      class="product-gallery--overlay-container"
      data-pixelzoom-overlay-container
    >
      {%
        include 'rimg',
        img: product.images[0],
        size: '1800x1000',
        lazy: true,
        canvas: true
      %}
    </div>
  </div>
{% endif %}

<script>
  (function() {
    var container = document.querySelector('[data-thumbnail-scroll-container]');
    var leftArrow = document.querySelector('[data-thumbnail-arrow="left"]');
    var rightArrow = document.querySelector('[data-thumbnail-arrow="right"]');

    if (!container || !leftArrow || !rightArrow) return;

    var scrollAmount = 120;

    function updateArrows() {
      var hasOverflow = container.scrollWidth > container.clientWidth;
      leftArrow.style.display = hasOverflow ? '' : 'none';
      rightArrow.style.display = hasOverflow ? '' : 'none';

      if (hasOverflow) {
        leftArrow.disabled = container.scrollLeft <= 0;
        rightArrow.disabled = container.scrollLeft + container.clientWidth >= container.scrollWidth - 1;
      }
    }

    leftArrow.addEventListener('click', function() {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    rightArrow.addEventListener('click', function() {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    container.addEventListener('scroll', updateArrows);
    window.addEventListener('resize', updateArrows);
    updateArrows();
  })();
</script>
