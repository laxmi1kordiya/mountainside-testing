{% comment %}
  Query-Param Collection Filters
  Uses query-string filtering: ?filter.p.vendor=x&filter.p.tag=y&filter.p.tag=z
  Price & Availability also use Shopify's query param filters
{% endcomment %}

{% comment %} ========== PARSE QUERY-STRING FILTER PARAMS ========== {% endcomment %}

{% assign qs = request.query_string | default: '' %}
{% assign qs_parts = qs | split: '&' %}

{% comment %} Collect raw vendor/tag values and handleized versions; also build the
   preserved query string (everything except vendor/tag filter params and page). {% endcomment %}
{% assign active_vendor_handles_str = '' %}
{% assign active_tag_handles_str = '' %}
{% assign preserved_query = '' %}
{% for part in qs_parts %}
  {% if part == '' %}{% continue %}{% endif %}
  {% assign kv = part | split: '=' %}
  {% assign k = kv[0] %}
  {% assign v = kv[1] | default: '' | replace: '%20', '-' | replace: '+', '-' %}
  {% assign v_handle = v | handleize %}
  {% if k == 'filter.p.vendor' %}
    {% if active_vendor_handles_str == '' %}{% assign active_vendor_handles_str = v_handle %}
    {% else %}{% assign active_vendor_handles_str = active_vendor_handles_str | append: '+' | append: v_handle %}{% endif %}
  {% elsif k == 'filter.p.tag' %}
    {% if active_tag_handles_str == '' %}{% assign active_tag_handles_str = v_handle %}
    {% else %}{% assign active_tag_handles_str = active_tag_handles_str | append: '+' | append: v_handle %}{% endif %}
  {% elsif k == 'page' %}
    {% comment %} drop {% endcomment %}
  {% else %}
    {% if preserved_query == '' %}{% assign preserved_query = part %}
    {% else %}{% assign preserved_query = preserved_query | append: '&' | append: part %}{% endif %}
  {% endif %}
{% endfor %}

{% assign active_vendor_handles = active_vendor_handles_str | split: '+' %}
{% assign active_tag_handles = active_tag_handles_str | split: '+' %}

{% comment %} Combined list (vendor+tag) retained for existing snippet APIs.
   ordered_vendor_part / ordered_tag_part keep their prior meaning. {% endcomment %}
{% assign ordered_vendor_part = active_vendor_handles_str %}
{% assign ordered_tag_part = active_tag_handles_str %}
{% if ordered_vendor_part != '' and ordered_tag_part != '' %}
  {% assign url_tag_segment_clean = ordered_vendor_part | append: '+' | append: ordered_tag_part %}
{% elsif ordered_vendor_part != '' %}
  {% assign url_tag_segment_clean = ordered_vendor_part %}
{% else %}
  {% assign url_tag_segment_clean = ordered_tag_part %}
{% endif %}
{% assign url_active_handles = url_tag_segment_clean | split: '+' %}

{% comment %} Query string (minus filter params + page) used to preserve sort/price/etc. {% endcomment %}
{% if preserved_query != '' %}
  {% assign preserved_query_string = '?' | append: preserved_query %}
{% else %}
  {% assign preserved_query_string = '' %}
{% endif %}

{% comment %} Base URL retained with only current vendor+tag filter params, used for
   availability/price links that append their own params. {% endcomment %}
{% assign current_filter_qs = '' %}
{% for vh in active_vendor_handles %}
  {% if vh == '' %}{% continue %}{% endif %}
  {% if current_filter_qs == '' %}{% assign current_filter_qs = 'filter.p.vendor=' | append: vh %}
  {% else %}{% assign current_filter_qs = current_filter_qs | append: '&filter.p.vendor=' | append: vh %}{% endif %}
{% endfor %}
{% for th in active_tag_handles %}
  {% if th == '' %}{% continue %}{% endif %}
  {% if current_filter_qs == '' %}{% assign current_filter_qs = 'filter.p.tag=' | append: th %}
  {% else %}{% assign current_filter_qs = current_filter_qs | append: '&filter.p.tag=' | append: th %}{% endif %}
{% endfor %}
{% if current_filter_qs != '' and preserved_query != '' %}
  {% assign tag_base_url = collection.url | append: '?' | append: current_filter_qs | append: '&' | append: preserved_query %}
{% elsif current_filter_qs != '' %}
  {% assign tag_base_url = collection.url | append: '?' | append: current_filter_qs %}
{% else %}
  {% assign tag_base_url = collection.url | append: preserved_query_string %}
{% endif %}

{% comment %} Calculate active filters count {% endcomment %}
{% assign active_filters_count = 0 %}
{% for h in url_active_handles %}
  {% if h != '' %}{% assign active_filters_count = active_filters_count | plus: 1 %}{% endif %}
{% endfor %}
{% for filter in collection.filters %}
  {% if filter.type == 'price_range' %}
    {% if filter.min_value.value != nil or filter.max_value.value != nil %}
      {% assign active_filters_count = active_filters_count | plus: 1 %}
    {% endif %}
  {% else %}
    {% for fv in filter.active_values %}
      {% assign active_filters_count = active_filters_count | plus: 1 %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% comment %}
  Build list of unique vendors from current collection.
  Also build a set of all tag handles (so we can filter out vendors
  whose handle does NOT match any tag — clicking those would lead to empty pages).
{% endcomment %}
{% assign vendor_list = '' %}
{% assign vendor_counts = '' %}
{% assign all_tag_handles = '' %}
{% for product in collection.products %}
  {% comment %} Collect all tag handles (used to validate vendor links work) {% endcomment %}
  {% for tag in product.tags %}
    {% assign t_handle = tag | handleize %}
    {% unless all_tag_handles contains t_handle %}
      {% if all_tag_handles == '' %}
        {% assign all_tag_handles = t_handle %}
      {% else %}
        {% assign all_tag_handles = all_tag_handles | append: '|||' | append: t_handle %}
      {% endif %}
    {% endunless %}
  {% endfor %}

  {% assign vendor_name = product.vendor %}
  {% if vendor_name != blank %}
    {% unless vendor_list contains vendor_name %}
      {% if vendor_list == '' %}
        {% assign vendor_list = vendor_name %}
        {% assign vendor_counts = '1' %}
      {% else %}
        {% assign vendor_list = vendor_list | append: '|||' | append: vendor_name %}
        {% assign vendor_counts = vendor_counts | append: '|||1' %}
      {% endif %}
    {% else %}
      {% assign vendor_array = vendor_list | split: '|||' %}
      {% assign count_array = vendor_counts | split: '|||' %}
      {% assign new_counts = '' %}
      {% for v in vendor_array %}
        {% assign idx = forloop.index0 %}
        {% if v == vendor_name %}
          {% assign current_count = count_array[idx] | plus: 1 %}
        {% else %}
          {% assign current_count = count_array[idx] %}
        {% endif %}
        {% if new_counts == '' %}
          {% assign new_counts = current_count %}
        {% else %}
          {% assign new_counts = new_counts | append: '|||' | append: current_count %}
        {% endif %}
      {% endfor %}
      {% assign vendor_counts = new_counts %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign vendors_array = vendor_list | split: '|||' %}
{% assign counts_array = vendor_counts | split: '|||' %}
{% assign tag_handles_set = all_tag_handles | split: '|||' %}

{% comment %} Build list of unique product types (for type filter & tag exclusion) {% endcomment %}
{% assign type_list = '' %}
{% for product in collection.products %}
  {% assign type_name = product.type %}
  {% if type_name != blank %}
    {% unless type_list contains type_name %}
      {% if type_list == '' %}
        {% assign type_list = type_name %}
      {% else %}
        {% assign type_list = type_list | append: '|||' | append: type_name %}
      {% endif %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign types_array_for_exclusion = type_list | split: '|||' %}

<div class="collection-filters" data-collection-filters>
  {% comment %} Close button for mobile {% endcomment %}
  <button type="button" class="collection-filters__close" data-filters-close aria-label="Close filters">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  {% comment %} ===================== AVAILABILITY FILTER (single-select) ===================== {% endcomment %}
  {% if show_filter_availability %}
  {% render 'collection-filter-availability', qs: qs, tag_base_url: tag_base_url %}
  {% endif %}

  {% comment %} ===================== PRICE FILTER ===================== {% endcomment %}
  {% if show_filter_price %}
  {% for filter in collection.filters %}
    {% if filter.type == 'price_range' %}
      <div class="collection-filters__group" data-filter-group="{{ filter.param_name }}">
        <div class="collection-filters__header">
          <span class="collection-filters__title">Price</span>
        </div>
        <div class="collection-filters__content">
          {% render 'collection-filter-price', filter: filter %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
  {% endif %}

  {% comment %} ===================== UNDERSCORE TAG GROUP FILTERS ===================== {% endcomment %}
  {% render 'collection-filter-underscore-tags', url_active_handles: url_active_handles, url_tag_segment_clean: url_tag_segment_clean, ordered_tag_part: ordered_tag_part, ordered_vendor_part: ordered_vendor_part, preserved_query_string: preserved_query_string %}

  {% comment %} ===================== VENDOR FILTER ===================== {% endcomment %}
  {% if show_filter_vendor %}
  {% render 'collection-filter-vendor', vendors_array: vendors_array, counts_array: counts_array, tag_handles_set: tag_handles_set, url_active_handles: url_active_handles, url_tag_segment_clean: url_tag_segment_clean, ordered_vendor_part: ordered_vendor_part, ordered_tag_part: ordered_tag_part, preserved_query_string: preserved_query_string %}
  {% endif %}

  {% comment %} ===================== COLLECTION FILTER (Query param based) ===================== {% endcomment %}
  {% if show_filter_collection %}
  {% render 'collection-filter-collection' %}
  {% endif %}

  {% comment %} ===================== TAGS FILTER (Tag-based URL) ===================== {% endcomment %}
  {% if show_filter_tags %}
  {% render 'collection-filter-tags', vendors_array: vendors_array, types_array_for_exclusion: types_array_for_exclusion, url_active_handles: url_active_handles, url_tag_segment_clean: url_tag_segment_clean, ordered_tag_part: ordered_tag_part, ordered_vendor_part: ordered_vendor_part, preserved_query_string: preserved_query_string %}
  {% endif %}

</div>

<button type="button" class="collection-filters__mobile-toggle" data-mobile-filters-toggle>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 4.5H16M2 9H16M2 13.5H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  <span>Filters{% if active_filters_count > 0 %} ({{ active_filters_count }}){% endif %}</span>
</button>

<div class="collection-filters__overlay" data-filters-overlay></div>
