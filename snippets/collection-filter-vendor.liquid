{% comment %} Vendor Filter (native query param or tag-based URL fallback) {% endcomment %}
{% comment %} Check if Shopify native vendor filter is available {% endcomment %}
{% assign has_native_vendor_filter = false %}
{% for filter in collection.filters %}
  {% if filter.param_name == 'filter.p.vendor' %}
    {% assign has_native_vendor_filter = true %}
    {% assign native_vendor_filter = filter %}
  {% endif %}
{% endfor %}

{% if has_native_vendor_filter %}
  {% comment %} Use Shopify native filter.p.vendor (query param based) {% endcomment %}
  <div class="collection-filters__group" data-filter-group="vendor">
    <div class="collection-filters__header">
      <span class="collection-filters__title">Vendor</span>
    </div>
    <div class="collection-filters__content">
      <div class="filter-list-scroll">
        <ul class="filter-list" data-filter-list>
          {% for value in native_vendor_filter.values %}
            {% if value.count > 0 or value.active %}
              <li class="filter-list__item">
                <a href="{{ value.url }}" class="filter-list__label{% if value.active %} filter-list__label--active{% endif %}">
                  <span class="filter-list__checkbox-icon">
                    <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                      <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span class="filter-list__text">{{ value.label }}</span>
                  <span class="filter-list__count">({{ value.count }})</span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
{% elsif vendors_array.size > 0 %}
  {% comment %} Fallback: Tag-based URL vendor filter {% endcomment %}
  <div class="collection-filters__group" data-filter-group="vendor">
    <div class="collection-filters__header">
      <span class="collection-filters__title">Vendor</span>
    </div>
    <div class="collection-filters__content">
      <div class="filter-list-scroll">
        <ul class="filter-list" data-filter-list>
          {% for vendor in vendors_array %}
            {% assign vendor_count = counts_array[forloop.index0] | default: 0 %}
            {% assign vendor_handle = vendor | handleize %}

            {% comment %} Skip vendors whose handle doesn't exist as a tag (would lead to empty filter page) {% endcomment %}
            {% assign vendor_has_tag = false %}
            {% for th in tag_handles_set %}
              {% if th == vendor_handle %}
                {% assign vendor_has_tag = true %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% unless vendor_has_tag %}{% continue %}{% endunless %}

            {% assign is_active = false %}
            {% for ath in url_active_handles %}
              {% assign ath_handle = ath | handleize %}
              {% if ath_handle == vendor_handle %}
                {% assign is_active = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% comment %} Build new vendor list (add or remove this vendor handle) {% endcomment %}
            {% assign new_vendor_part = '' %}
            {% if is_active %}
              {% assign ovp_arr = ordered_vendor_part | split: '+' %}
              {% for p in ovp_arr %}
                {% if p == '' or p == vendor_handle %}{% continue %}{% endif %}
                {% if new_vendor_part == '' %}{% assign new_vendor_part = p %}
                {% else %}{% assign new_vendor_part = new_vendor_part | append: '+' | append: p %}{% endif %}
              {% endfor %}
            {% else %}
              {% if ordered_vendor_part != '' %}{% assign new_vendor_part = ordered_vendor_part | append: '+' | append: vendor_handle %}
              {% else %}{% assign new_vendor_part = vendor_handle %}{% endif %}
            {% endif %}

            {% assign filter_qs = '' %}
            {% assign nvp_arr = new_vendor_part | split: '+' %}
            {% for vh in nvp_arr %}
              {% if vh == '' %}{% continue %}{% endif %}
              {% if filter_qs == '' %}{% assign filter_qs = 'filter.p.vendor=' | append: vh %}
              {% else %}{% assign filter_qs = filter_qs | append: '&filter.p.vendor=' | append: vh %}{% endif %}
            {% endfor %}
            {% assign otp_arr = ordered_tag_part | split: '+' %}
            {% for th in otp_arr %}
              {% if th == '' %}{% continue %}{% endif %}
              {% if filter_qs == '' %}{% assign filter_qs = 'filter.p.tag=' | append: th %}
              {% else %}{% assign filter_qs = filter_qs | append: '&filter.p.tag=' | append: th %}{% endif %}
            {% endfor %}
            {% assign preserved_q = preserved_query_string | remove_first: '?' %}
            {% if filter_qs != '' and preserved_q != '' %}
              {% assign filter_url = collection.url | append: '?' | append: filter_qs | append: '&' | append: preserved_q %}
            {% elsif filter_qs != '' %}
              {% assign filter_url = collection.url | append: '?' | append: filter_qs %}
            {% elsif preserved_q != '' %}
              {% assign filter_url = collection.url | append: '?' | append: preserved_q %}
            {% else %}
              {% assign filter_url = collection.url %}
            {% endif %}

            <li class="filter-list__item">
              <a href="{{ filter_url }}" class="filter-list__label{% if is_active %} filter-list__label--active{% endif %}" data-tag-filter>
                <span class="filter-list__checkbox-icon">
                  <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                    <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="filter-list__text">{{ vendor }}</span>
                <span class="filter-list__count">({{ vendor_count }})</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
{% endif %}
