{% assign shipping_text = block.settings.text | default: 'Free Shipping on orders $100' %}
<div class="product-shipping-info" {{ block.shopify_attributes }}>
  {% if block.settings.show_icon %}
    <div class="product-shipping-info__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
  {% endif %}
  <div class="product-shipping-info__text">
    <span>{{ shipping_text }}</span>
    {% if block.settings.text_2 != blank %}
      <span>{{ block.settings.text_2 }}</span>
    {% endif %}
    {% if block.settings.text_3 != blank %}
      <span>{{ block.settings.text_3 }}</span>
    {% endif %}
  </div>
</div>

<style>
  .product-shipping-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    margin: 5px 0;
    background: #e8f5e9;
    border-radius: 4px;
  }

  .product-shipping-info__icon {
    flex-shrink: 0;
    color: #2d5a3d;
  }

  .product-shipping-info__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.4;
    color: #2d5a3d;
  }

  .product-shipping-info__text span {
    font-weight: 600;
  }

  @media screen and (max-width: 767px) {
    .product-shipping-info__text {
      font-size: 13px;
    }

    .product-shipping-info__icon svg {
      width: 18px;
      height: 18px;
    }
  }
</style>
