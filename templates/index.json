tio":"0.75","reviews_shown":5,"show_reviewer_name":true,"show_product_name":true,"hide_arrows_mobile":false,"arrows_position":"sides","max_width":1500,"corner_styling":"extra_round","header_text_color":"#000000","text_color":"#000000","card_color":"#e9f1e9","stars_color":"#367b36","arrows_color":"#367b36","transition_speed":3,"header_text":"Customers are saying","show_average_rating":true}},"judge_me_reviews_medals_QqAnXG":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/medals\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["judge_me_reviews_cards_carousel_6Wcrnr","judge_me_reviews_medals_QqAnXG"],"settings":{}},"1764964998118a7738":{"type":"_blocks","blocks":{"ai_gen_block_a81f60c_QGUkzq":{"type":"ai_gen_block_a81f60c","settings":{"section_title":"Why Choose Us?","section_subtitle":"Find out what makes us different and why thousands of customers trust us.","card_1_title":"500K+ Served","card_1_text":"We've supported over half a million customers with dependable, competitively priced medical supplies.","card_2_title":"B2B Excellence","card_2_text":"We specialize in serving healthcare facilities, government agencies, and professional buyers.","card_3_title":"Trusted Supply","card_3_text":"We partner directly with leading manufacturers, ensuring you receive only authentic, and compliant.","card_4_title":"Veteran-Owned","card_4_text":"As a certified Service-Disabled Veteran-Owned Small Business, we uphold the highest standards of integrity.","card_5_title":"FDA Compliant","card_5_text":"We distribute FDA-approved products that meet stringent healthcare, safety standards, and clinical trust.","card_6_title":"Easy Returns","card_6_text":"Our 30-day return policy provides confidence and flexibility, safe, and hassle-free.","container_max_width":1200,"section_padding_top":80,"section_padding_bottom":80,"header_spacing":50,"grid_margin_top":40,"card_gap":30,"card_padding":40,"background_color":"#ffffff","title_color":"#367b36","subtitle_color":"#4d4d4d","card_background":"#ffffff","card_border_color":"#6cc16e","icon_color":"#6cc16e","card_title_color":"#0e0e0e","card_text_color":"#4d4d4d","card_hover_shadow_color":"#6cc16e4d","title_size":42,"title_margin":16,"subtitle_size":18,"card_title_size":20,"card_title_margin":12,"card_text_size":15,"card_border_width":1,"card_border_radius":14,"icon_size":50,"icon_margin":20,"card_hover_lift":7,"card_hover_shadow_y":12,"card_hover_shadow_blur":34},"blocks":{}}},"block_order":["ai_gen_block_a81f60c_QGUkzq"],"settings":{}},"dynamic_rich_text_gU7GGA":{"type":"dynamic-rich-text","blocks":{"text_Bgw644":{"type":"text","settings":{"title":"Service-Disabled Veteran-Owned Small Business","text":"<p>Mountainside Medical Equipment is a verified Service-Disabled Veteran Owned Small Business (SDVOSB) that distributes medical supplies and equipment to VA Hospitals and government agencies across the USA.<\/p><p>Mountainside Medical is a family-owned business established in June of 2002 by a Father, Son and Daughter team that has been serving healthcare professionals for more than 20 years. Mountainside's President Marty Zarnock Sr. was drafted and served in the 82nd Airborne Division is a U.S. Army in the Vietnam War.<\/p>","heading_size":"large","text_alignment":"left"}}},"block_order":["text_Bgw644"],"custom_css":["* {margin-top: 0px;}"],"settings":{"width":"wide"}},"dynamic_rich_text_TWtdQY":{"type":"dynamic-rich-text","blocks":{"text_VTCp7d":{"type":"text","settings":{"title":"Family-Owned & Operated Business","text":"<p>Since June 2002, Mountainside Medical Equipment has been committed to enhancing health and wellness by offering top-quality medical supplies. As a family-owned and operated business, founded by a dynamic father, son, and daughter team, we are deeply committed to offering personalized service and exceptional value to our clients across various healthcare settings. Guided by core family values, we place a strong emphasis on trust, reliability, and customer satisfaction. Our knowledgeable team is dedicated to supporting healthcare professionals and families with the resources they need to enhance patient care and improve quality of life<\/p>","heading_size":"medium","text_alignment":"left"}}},"block_order":["text_VTCp7d"],"custom_css":["* {margin-top: 0px;}"],"settings":{"width":"wide"}},"dynamic_rich_text_afmKTw":{"type":"dynamic-rich-text","blocks":{"text_Y9XQBh":{"type":"text","settings":{"title":"About Mountainside Medical","text":"<p>Discover the exceptional quality and value  at Mountainside Medical Equipment, your premier wholesaler and trusted distributor of top-tier medical supplies. Proudly standing as a Service-Disabled Veteran-Owned Small Business, we are deeply committed to serving healthcare professionals and facilities nationwide with integrity and dedication. From everyday essentials to specialized equipment, Mountainside Medical Equipment is dedicated to providing you with innovative solutions and dependable products. Explore our comprehensive selection and experience the Mountainside advantage—where quality, affordability, and trust converge. Visit Mountainside Medical Equipment today and elevate your standards in medical supplies procurement. Explore our seamless, user-friendly shopping experience and discover why we are a preferred partner in medical supplies. At Mountainside Medical Equipment, we are not just a supplier— we are a committed member of your healthcare journey, providing the quality and service you trust. Visit us today and see the difference a family touch can make in providing superior medical solutions.<\/p>","heading_size":"medium","text_alignment":"left"}}},"block_order":["text_Y9XQBh"],"custom_css":["* {margin-top: 0px;}"],"settings":{"width":"wide"}},"dynamic_blog_posts_YdetRM":{"type":"dynamic-blog-posts","custom_css":["* {margin-top: 0px;}"],"name":"Blog posts","settings":{"title":"Blog posts","blog":"medical-supplies","show_date":true,"show_author":true,"show_excerpt":true}},"pxs