<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="rotating-announcement-bar">
</script>

{% if section.settings.show_bar %}
<div
  class="rotating-announcement-bar"
  data-section-id="{{ section.id }}"
  data-animation-style="{{ section.settings.animation_style }}"
  data-animation-duration="{{ section.settings.animation_duration }}"
  data-display-duration="{{ section.settings.display_duration }}"
  style="
    {% if section.settings.use_gradient %}
      background: linear-gradient({{ section.settings.gradient_direction }}deg, {{ section.settings.gradient_color_1 }}, {{ section.settings.gradient_color_2 }});
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    height: {{ section.settings.bar_height }}px;
    overflow: hidden;
    position: relative;
  ">
  <div class="rotating-announcement-bar__container">
    <!-- Left Section: Contact Info -->
    <div class="rotating-announcement-bar__left"
      style="
        color: {{ section.settings.left_text_color }};
        font-size: {{ section.settings.left_font_size }}px;
        font-weight: {{ section.settings.left_font_weight }};
      ">
      {% if section.settings.show_phone %}
        <a href="tel:{{ section.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
           class="rotating-announcement-bar__contact-item"
           style="color: inherit; text-decoration: none;">
          <svg class="rotating-announcement-bar__icon" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span class="rotating-announcement-bar__contact-text">{{ section.settings.phone_number }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_phone and section.settings.show_email %}
        <span class="rotating-announcement-bar__separator">|</span>
      {% endif %}

      {% if section.settings.show_email %}
        <a href="mailto:{{ section.settings.email_address }}"
           class="rotating-announcement-bar__contact-item"
           style="color: inherit; text-decoration: none;">
          <svg class="rotating-announcement-bar__icon" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span class="rotating-announcement-bar__contact-text">{{ section.settings.email_address }}</span>
        </a>
      {% endif %}
    </div>

    <!-- Center Section: Rotating Messages -->
    <div class="rotating-announcement-bar__center">
      <!-- Desktop Messages -->
      <div class="rotating-announcement-bar__desktop">
        {% for block in section.blocks %}
          {% if block.type == 'announcement_message' %}
            <div
              class="rotating-announcement-bar__message {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
              style="
                color: {{ section.settings.text_color }};
                font-size: {{ section.settings.font_size }}px;
                font-weight: {{ section.settings.font_weight }};
              ">
              {% if block.settings.message_link != blank %}
                <a href="{{ block.settings.message_link }}" style="color: inherit; text-decoration: none;">
                  {{ block.settings.message_text }}
                </a>
              {% else %}
                {{ block.settings.message_text }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Mobile Messages -->
      <div class="rotating-announcement-bar__mobile">
        {% for block in section.blocks %}
          {% if block.type == 'announcement_message' %}
            <div
              class="rotating-announcement-bar__message {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
              style="
                color: {{ section.settings.mobile_text_color }};
                font-size: {{ section.settings.mobile_font_size }}px;
                font-weight: {{ section.settings.mobile_font_weight }};
              ">
              {% if block.settings.mobile_message_link != blank %}
                <a href="{{ block.settings.mobile_message_link }}" style="color: inherit; text-decoration: none;">
                  {% if block.settings.mobile_message_text != blank %}
                    {{ block.settings.mobile_message_text }}
                  {% else %}
                    {{ block.settings.message_text }}
                  {% endif %}
                </a>
              {% elsif block.settings.message_link != blank %}
                <a href="{{ block.settings.message_link }}" style="color: inherit; text-decoration: none;">
                  {% if block.settings.mobile_message_text != blank %}
                    {{ block.settings.mobile_message_text }}
                  {% else %}
                    {{ block.settings.message_text }}
                  {% endif %}
                </a>
              {% else %}
                {% if block.settings.mobile_message_text != blank %}
                  {{ block.settings.mobile_message_text }}
                {% else %}
                  {{ block.settings.message_text }}
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Right Section: Cart and Login/Account -->
    <div class="rotating-announcement-bar__right"
      style="
        color: {{ section.settings.right_text_color }};
        font-size: {{ section.settings.right_font_size }}px;
        font-weight: {{ section.settings.right_font_weight }};
      ">
      {% if section.settings.show_account %}
        {% if customer %}
          <a href="/account"
             class="rotating-announcement-bar__right-item"
             style="color: inherit; text-decoration: none;">
            <svg class="rotating-announcement-bar__icon" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>My Account</span>
          </a>
        {% else %}
          <a href="/account/login"
             class="rotating-announcement-bar__right-item"
             style="color: inherit; text-decoration: none;">
            <svg class="rotating-announcement-bar__icon" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Login</span>
          </a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  {%- comment -%} Dynamic styles that depend on section settings {%- endcomment -%}
  .rotating-announcement-bar__message {
    transition: opacity {{ section.settings.animation_duration }}ms ease-in-out;
  }

  .rotating-announcement-bar[data-animation-style="slide-up"] .rotating-announcement-bar__message,
  .rotating-announcement-bar[data-animation-style="slide-down"] .rotating-announcement-bar__message,
  .rotating-announcement-bar[data-animation-style="slide-left"] .rotating-announcement-bar__message,
  .rotating-announcement-bar[data-animation-style="slide-right"] .rotating-announcement-bar__message {
    transition: opacity {{ section.settings.animation_duration }}ms ease-in-out,
                transform {{ section.settings.animation_duration }}ms ease-in-out;
  }

  @media screen and (max-width: {{ section.settings.mobile_breakpoint }}px) {
    .rotating-announcement-bar {
      height: {{ section.settings.mobile_bar_height }}px !important;
    }

    .rotating-announcement-bar__container {
      padding: 0 10px;
    }

    .rotating-announcement-bar__left {
      font-size: {{ section.settings.mobile_left_font_size }}px;
      gap: {% if section.settings.hide_left_text_mobile %}10px{% else %}5px{% endif %};
      {% if section.settings.hide_left_text_mobile %}
        flex-shrink: 0;
        min-width: auto;
      {% endif %}
    }

    {% if section.settings.hide_left_text_mobile %}
      .rotating-announcement-bar__contact-text {
        display: none;
      }
      .rotating-announcement-bar__separator {
        display: none;
      }
    {% endif %}

    .rotating-announcement-bar__right {
      font-size: {{ section.settings.mobile_right_font_size }}px;
      gap: {% if section.settings.hide_right_text_mobile %}10px{% else %}10px{% endif %};
      {% if section.settings.hide_right_text_mobile %}
        flex-shrink: 0;
        min-width: auto;
      {% endif %}
    }

    {% if section.settings.hide_right_text_mobile %}
      .rotating-announcement-bar__right-item span {
        display: none;
      }
    {% endif %}

    .rotating-announcement-bar__center {
      {% if section.settings.hide_left_text_mobile and section.settings.hide_right_text_mobile %}
        position: static;
        transform: none;
        flex: 1;
        min-width: 0;
        padding: 0 10px;
        overflow: hidden;
      {% else %}
        width: 40%;
      {% endif %}
    }

    .rotating-announcement-bar__message {
      padding: 0 5px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .rotating-announcement-bar__desktop {
      display: none;
    }

    .rotating-announcement-bar__mobile {
      display: block;
    }

    {% if section.settings.hide_left_mobile %}
      .rotating-announcement-bar__left {
        display: none;
      }
      .rotating-announcement-bar__center {
        left: 30%;
        width: 40%;
      }
    {% endif %}

    {% if section.settings.hide_right_mobile %}
      .rotating-announcement-bar__right {
        display: none;
      }
      .rotating-announcement-bar__center {
        left: auto;
        right: 10px;
        transform: none;
        width: 50%;
      }
    {% endif %}
  }
</style>

<script>
  (function() {
    const announcementBar = document.querySelector('.rotating-announcement-bar[data-section-id="{{ section.id }}"]');
    if (!announcementBar) return;

    const animationDuration = parseInt(announcementBar.dataset.animationDuration) || 500;
    const displayDuration = parseInt(announcementBar.dataset.displayDuration) || 3000;

    // Get messages based on screen size
    function getMessages() {
      const isMobile = window.innerWidth <= {{ section.settings.mobile_breakpoint }};
      return announcementBar.querySelectorAll(isMobile ? '.rotating-announcement-bar__mobile .rotating-announcement-bar__message' : '.rotating-announcement-bar__desktop .rotating-announcement-bar__message');
    }

    let currentIndex = 0;
    let messages = getMessages();
    let rotationInterval;

    function showMessage(index) {
      messages.forEach((msg, i) => {
        if (i === index) {
          msg.classList.add('active');
        } else {
          msg.classList.remove('active');
        }
      });
    }

    function rotateMessages() {
      if (messages.length <= 1) return;

      currentIndex = (currentIndex + 1) % messages.length;
      showMessage(currentIndex);
    }

    function startRotation() {
      if (rotationInterval) {
        clearInterval(rotationInterval);
      }

      messages = getMessages();
      if (messages.length > 0) {
        showMessage(0);
        currentIndex = 0;

        if (messages.length > 1) {
          rotationInterval = setInterval(rotateMessages, displayDuration + animationDuration);
        }
      }
    }

    // Handle window resize
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        startRotation();
      }, 250);
    });

    // Initialize
    startRotation();
  })();
</script>
{% endif %}

{% schema %}
