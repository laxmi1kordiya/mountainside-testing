              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_2_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_2_text }}</p>
      </div>

      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_3_icon %}
            <img src="{{ section.settings.card_3_icon | image_url: width: 200 }}" alt="{{ section.settings.card_3_title }}" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_3_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_3_text }}</p>
      </div>

      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_4_icon %}
            <img src="{{ section.settings.card_4_icon | image_url: width: 200 }}" alt="{{ section.settings.card_4_title }}" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_4_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_4_text }}</p>
      </div>

      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_5_icon %}
            <img src="{{ section.settings.card_5_icon | image_url: width: 200 }}" alt="{{ section.settings.card_5_title }}" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_5_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_5_text }}</p>
      </div>

      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_6_icon %}
            <img src="{{ section.settings.card_6_icon | image_url: width: 200 }}" alt="{{ section.settings.card_6_title }}" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_6_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_6_text }}</p>
      </div>
    </div>
  </div>
</div>

