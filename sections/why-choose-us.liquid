      "id": "card_title_size",
      "min": 16,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Card title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 13,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Card text size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 60
