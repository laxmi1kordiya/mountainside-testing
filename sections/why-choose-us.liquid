{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-why-choose-us-{{ ai_gen_id }} {
    padding: {{ section.settings.section_padding }}px 20px;
    background: {{ section.settings.background_color }};
  }

  .ai-why-choose-us-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-why-choose-us-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-why-choose-us-title-{{ ai_gen_id }} {
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .ai-why-choose-us-subtitle-{{ ai_gen_id }} {
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-why-choose-us-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 30px;
  }

  .ai-why-choose-us-card-{{ ai_gen_id }} {
    background: {{ section.settings.card_background }};
    padding: 40px 30px;
    border-radius: {{ section.settings.card_border_radius }}px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: {{ section.settings.shadow_horizontal }}px {{ section.settings.shadow_vertical }}px {{ section.settings.shadow_blur }}px {{ section.settings.shadow_color | color_modify: 'alpha', section.settings.shadow_opacity }};
    border: {{ section.settings.border_width }}px {{ section.settings.border_style }} {{ section.settings.border_color }};
  }

  .ai-why-choose-us-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: {{ section.settings.shadow_horizontal }}px {{ section.settings.shadow_vertical | plus: 6 }}px {{ section.settings.shadow_blur | plus: 12 }}px {{ section.settings.shadow_color | color_modify: 'alpha', section.settings.shadow_opacity | plus: 0.04 }};
    border-color: {{ section.settings.border_hover_color }};
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin: 0 auto 25px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ section.settings.accent_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-why-choose-us-card-title-{{ ai_gen_id }} {
    font-size: {{ section.settings.card_title_size }}px;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-why-choose-us-card-text-{{ ai_gen_id }} {
    font-size: {{ section.settings.card_text_size }}px;
    color: {{ section.settings.card_text_color }};
    line-height: 1.7;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-why-choose-us-{{ ai_gen_id }} {
      padding: {{ section.settings.section_padding | times: 0.6 }}px 15px;
    }

    .ai-why-choose-us-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<div class="ai-why-choose-us-{{ ai_gen_id }}">
  <div class="ai-why-choose-us-container-{{ ai_gen_id }}">
    {% if section.settings.section_title != blank or section.settings.section_subtitle != blank %}
      <div class="ai-why-choose-us-header-{{ ai_gen_id }}">
        {% if section.settings.section_title != blank %}
          <h2 class="ai-why-choose-us-title-{{ ai_gen_id }}">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_subtitle != blank %}
          <p class="ai-why-choose-us-subtitle-{{ ai_gen_id }}">{{ section.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-why-choose-us-grid-{{ ai_gen_id }}">
      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_1_icon %}
            <img src="{{ section.settings.card_1_icon | image_url: width: 200 }}" alt="{{ section.settings.card_1_title }}" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ section.settings.card_1_title }}</h3>
        <p class="ai-why-choose-us-card-text-{{ ai_gen_id }}">{{ section.settings.card_1_text }}</p>
      </div>

      <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
        <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
          {% if section.settings.card_2_icon %}
            <img src="{{ section.settings.card_2_icon | image_url: width: 200 }}" alt="{{ section.settings.card_2_title }}" loading="lazy">
          {% else %}
