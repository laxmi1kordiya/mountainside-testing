{% if section.settings.show_related_searches %}
  {% render 'collection-related-searches',
    related_searches_title: section.settings.heading,
    related_searches_max: section.settings.max_tags,
    rs_bg: section.settings.section_bg_color,
    rs_title_color: section.settings.title_color,
    rs_pill_bg: section.settings.tag_bg_color,
    rs_pill_text: section.settings.tag_text_color,
    rs_pill_hover_bg: section.settings.tag_hover_bg_color,
    rs_pill_hover_text: section.settings.tag_hover_text_color
  %}
{% endif %}

{% schema %}
{
  "name": "Related Searches",
  "class": "collection-related-searches--section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "show_related_searches",
      "label": "Show related searches",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "People Also Searched For"
    },
    {
      "type": "range",
      "id": "max_tags",
      "min": 4,
      "max": 30,
      "step": 1,
      "label": "Maximum items to show",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Title Styling"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Tag Styling"
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag background color",
      "default": "#e8f5e9"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text color",
      "default": "#388138"
    },
    {
      "type": "color",
      "id": "tag_hover_bg_color",
      "label": "Tag hover background",
      "default": "#e8f5e9"
    },
    {
      "type": "color",
      "id": "tag_hover_text_color",
      "label": "Tag hover text color",
      "default": "#388138"
    }
  ],
  "presets": [
    {
      "name": "Related Searches"
    },
  ]
}
{% endschema %}
