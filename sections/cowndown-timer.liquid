
{% assign ai_gen_id = section.id | replace: '_', '' | replace: '-', '' | downcase %}

{% style %}

  .ai-countdown-timer-{{ ai_gen_id }} {
    padding: clamp(20px, {{ section.settings.padding_mobile }}vw, {{ section.settings.padding_desktop }}px);
    background-color: {{ section.settings.background_color }};
    border-radius: clamp(4px, {{ section.settings.border_radius_mobile }}vw, {{ section.settings.border_radius_desktop }}px);
    text-align: center;
    width: 100%;
    max-width: 100%;
  }

  .ai-countdown-timer__heading-{{ ai_gen_id }} {
    color: {{ section.settings.heading_color }};
    font-size: clamp({{ section.settings.heading_size_mobile }}px, {{ section.settings.heading_size_tablet }}vw, {{ section.settings.heading_size_desktop }}px);
    margin: 0 0 clamp(12px, {{ section.settings.spacing_mobile }}vw, {{ section.settings.spacing_desktop }}px) 0;
    line-height: 1.2;
  }

  .ai-countdown-timer__display-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp({{ section.settings.gap_mobile }}px, {{ section.settings.gap_tablet }}%, {{ section.settings.gap_desktop }}px);
    flex-wrap: nowrap;
    width: 100%;
  }

  .ai-countdown-timer__segment-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-width: 0;
    padding: clamp(6px, 1.5vw, 16px);
    background-color: {{ section.settings.segment_background }};
    border-radius: clamp(4px, 1vw, {{ section.settings.segment_border_radius }}px);
    {% if section.settings.show_segment_border %}
      border: {{ section.settings.segment_border_width }}px solid {{ section.settings.segment_border_color }};
    {% endif %}
  }

  .ai-countdown-timer__value-{{ ai_gen_id }} {
    font-size: clamp({{ section.settings.value_size_mobile }}px, {{ section.settings.value_size_tablet }}vw, {{ section.settings.value_size_desktop }}px);
    font-weight: {{ section.settings.value_weight }};
    color: {{ section.settings.value_color }};
    line-height: 1;
    margin-bottom: clamp(2px, 0.5vw, 8px);
    font-variant-numeric: tabular-nums;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    font-size: clamp({{ section.settings.label_size_mobile }}px, {{ section.settings.label_size_tablet }}vw, {{ section.settings.label_size_desktop }}px);
    color: {{ section.settings.label_color }};
    text-transform: {{ section.settings.label_transform }};
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }} {
    display: none;
    color: {{ section.settings.expired_color }};
    font-size: clamp({{ section.settings.expired_size_mobile }}px, {{ section.settings.expired_size_tablet }}vw, {{ section.settings.expired_size_desktop }}px);
    padding: clamp(12px, 3vw, 24px);
    font-weight: 600;
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 480px) {
    .ai-countdown-timer__display-{{ ai_gen_id }} {
      gap: {{ section.settings.gap_mobile }}px;
      padding-left: 12px;
      padding-right: 12px;
    }

    .ai-countdown-timer__segment-{{ ai_gen_id }} {
      padding: 8px 4px;
      max-width: 25%;
    }

    .ai-countdown-timer__label-{{ ai_gen_id }} {
      font-size: {{ section.settings.label_size_mobile }}px;
    }
  }

  @media screen and (min-width: 481px) and (max-width: 768px) {
    .ai-countdown-timer__display-{{ ai_gen_id }} {
      gap: {{ section.settings.gap_tablet }}%;
    }

    .ai-countdown-timer__segment-{{ ai_gen_id }} {
      flex: 0 1 auto;
      min-width: clamp(70px, {{ section.settings.segment_width_tablet }}vw, 120px);
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .ai-countdown-timer__display-{{ ai_gen_id }} {
      gap: calc({{ section.settings.gap_tablet }}% * 1.2);
    }

    .ai-countdown-timer__segment-{{ ai_gen_id }} {
      min-width: clamp(90px, {{ section.settings.segment_width_tablet }}vw, 140px);
    }
  }

  @media screen and (min-width: 1025px) {
    .ai-countdown-timer__display-{{ ai_gen_id }} {
      gap: {{ section.settings.gap_desktop }}px;
    }

    .ai-countdown-timer__segment-{{ ai_gen_id }} {
      flex: 0 1 auto;
      min-width: {{ section.settings.segment_width_desktop }}px;
    }
  }

  @media screen and (min-width: 1440px) {
    .ai-countdown-timer-{{ ai_gen_id }} {
      max-width: {{ section.settings.max_width_large }}px;
      margin-left: auto;
      margin-right: auto;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-end-date="{{ section.settings.end_date }}"
  data-end-time="{{ section.settings.end_time }}"
  {{ section.shopify_attributes }}
>
  {% if section.settings.heading != blank %}
    <h2 class="ai-countdown-timer__heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="ai-countdown-timer__display-{{ ai_gen_id }}">
    <div class="ai-countdown-timer__segment-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-days>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ section.settings.days_label }}</div>
    </div>

    <div class="ai-countdown-timer__segment-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-hours>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ section.settings.hours_label }}</div>
    </div>

    <div class="ai-countdown-timer__segment-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-minutes>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ section.settings.minutes_label }}</div>
    </div>

    <div class="ai-countdown-timer__segment-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-seconds>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ section.settings.seconds_label }}</div>
    </div>
  </div>

  {% if section.settings.expired_message != blank %}
    <div class="ai-countdown-timer__expired-{{ ai_gen_id }}">
      {{ section.settings.expired_message }}
    </div>
  {% endif %}
</countdown-timer-{{ ai_gen_id }}>
<script>
    
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.interval = null;
      }

      connectedCallback() {
        this.daysElement = this.querySelector('[data-days]');
        this.hoursElement = this.querySelector('[data-hours]');
        this.minutesElement = this.querySelector('[data-minutes]');
        this.secondsElement = this.querySelector('[data-seconds]');
        this.displayElement = this.querySelector('.ai-countdown-timer__display-{{ ai_gen_id }}');
        this.expiredElement = this.querySelector('.ai-countdown-timer__expired-{{ ai_gen_id }}');

        if (this.endDate) {
          this.startCountdown();
        }
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      startCountdown() {
        const targetDateTime = this.getTargetDateTime();

        if (!targetDateTime) {
          return;
        }

        this.updateDisplay(targetDateTime);

        this.interval = setInterval(() => {
          this.updateDisplay(targetDateTime);
        }, 1000);
      }

      getTargetDateTime() {
        if (!this.endDate) {
          return null;
        }

        const timeString = this.endTime || '23:59';
        const dateTimeString = `${this.endDate}T${timeString}:00`;
        const targetDate = new Date(dateTimeString);

        if (isNaN(targetDate.getTime())) {
          return null;
        }

        return targetDate;
      }

      updateDisplay(targetDateTime) {
        const now = new Date().getTime();
        const distance = targetDateTime.getTime() - now;

        if (distance < 0) {
          this.handleExpired();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.daysElement.textContent = this.padZero(days);
        this.hoursElement.textContent = this.padZero(hours);
        this.minutesElement.textContent = this.padZero(minutes);
        this.secondsElement.textContent = this.padZero(seconds);
      }

      handleExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }

        this.daysElement.textContent = '00';
        this.hoursElement.textContent = '00';
        this.minutesElement.textContent = '00';
        this.secondsElement.textContent = '00';

        if (this.expiredElement) {
          this.displayElement.style.display = 'none';
          this.expiredElement.classList.add('active');
        }
      }

      padZero(num) {
        return num.toString().padStart(2, '0');
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

{% schema %}
