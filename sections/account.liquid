<section class="account-page-v2" data-template-account>
  <!-- Welcome Banner -->
  <div class="account-welcome-banner">
    <div class="account-welcome-content">
      <div class="account-welcome-info">
        <div class="account-avatar">
          <span class="account-avatar-initial">{{ customer.first_name | slice: 0 | upcase }}</span>
        </div>
        <div class="account-welcome-text">
          <h1 class="account-welcome-title">Welcome back, {{ customer.first_name }}!</h1>
          <p class="account-welcome-email">{{ customer.email }}</p>
        </div>
      </div>
      <div class="account-quick-actions">
        <a href="/account/addresses" class="account-quick-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Addresses</span>
        </a>
        <a href="{{ routes.account_logout_url }}" class="account-quick-btn account-quick-btn--logout">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16,17 21,12 16,7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Logout</span>
        </a>
      </div>
    </div>
  </div>

  <div class="account-main-content">
    <!-- Stats Cards -->
    <div class="account-stats-row">
      <div class="account-stat-card">
        <div class="account-stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <div class="account-stat-info">
          <span class="account-stat-value">{{ customer.orders_count }}</span>
          <span class="account-stat-label">Total Orders</span>
        </div>
      </div>
      <div class="account-stat-card">
        <div class="account-stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="account-stat-info">
          <span class="account-stat-value">{{ customer.addresses_count }}</span>
          <span class="account-stat-label">Saved Addresses</span>
        </div>
      </div>
      <div class="account-stat-card">
        <div class="account-stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="account-stat-info">
          <span class="account-stat-value">{{ customer.created_at | date: "%b %Y" }}</span>
          <span class="account-stat-label">Member Since</span>
        </div>
      </div>
    </div>

    <div class="account-grid">
      <!-- Order History Section -->
      <div class="account-card account-card--orders">
        <div class="account-card-header">
          <h2 class="account-card-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            Order History
          </h2>
        </div>
        <div class="account-card-body">
          {% if customer.orders.size > 0 %}
            {% paginate customer.orders by 10 %}
              <div class="account-orders-list">
                {% for order in customer.orders %}
                  <div class="account-order-item">
                    <div class="account-order-main">
                      <div class="account-order-info">
                        <a href="{{ order.customer_url }}" class="account-order-number">{{ order.name }}</a>
                        <span class="account-order-date">{{ order.created_at | date: "%B %d, %Y" }}</span>
                      </div>
                      <div class="account-order-statuses">
                        <span class="account-status-badge account-status--payment-{{ order.financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                        {% if order.fulfillment_status %}
                          <span class="account-status-badge account-status--fulfillment-{{ order.fulfillment_status }}">
                            {{ order.fulfillment_status_label }}
                          </span>
                        {% else %}
                          <span class="account-status-badge account-status--fulfillment-unfulfilled">
                            Unfulfilled
                          </span>
                        {% endif %}
                      </div>
                    </div>
                    <div class="account-order-actions">
                      <span class="account-order-total">{{ order.total_price | money }}</span>
                      <div class="account-order-buttons">
                        <a href="{{ order.customer_url }}" class="account-btn account-btn--secondary account-btn--sm">View</a>
                        <div data-id="{{ order.id }}" class="identixweb_advance_reorder account-reorder-btn"></div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if paginate.pages > 1 %}
                <div class="account-pagination">
                  {% include 'pagination' %}
                </div>
              {% endif %}
            {% endpaginate %}
          {% else %}
            <div class="account-empty-state">
              <div class="account-empty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </div>
              <h3 class="account-empty-title">No orders yet</h3>
              <p class="account-empty-text">When you place orders, they will appear here.</p>
              <a href="/collections/all" class="account-btn account-btn--primary">Start Shopping</a>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Account Info Sidebar -->
      <div class="account-sidebar">
        <!-- Default Address Card -->
        <div class="account-card">
          <div class="account-card-header">
            <h2 class="account-card-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Default Address
            </h2>
          </div>
          <div class="account-card-body">
            {% if customer.default_address != nil %}
              <div class="account-address-display">
                {% include 'account-address-list', address: customer.default_address %}
              </div>
            {% else %}
              <p class="account-no-address">No default address set</p>
            {% endif %}
            <a href="/account/addresses" class="account-btn account-btn--outline account-btn--full">
              {% if customer.addresses_count == 0 %}
                Add Address
              {% else %}
                Manage Addresses ({{ customer.addresses_count }})
              {% endif %}
            </a>
          </div>
        </div>

        <!-- Account Details Card -->
        <div class="account-card">
          <div class="account-card-header">
            <h2 class="account-card-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              Account Details
            </h2>
          </div>
          <div class="account-card-body">
            <div class="account-detail-row">
              <span class="account-detail-label">Name</span>
              <span class="account-detail-value">{{ customer.name }}</span>
            </div>
            <div class="account-detail-row">
              <span class="account-detail-label">Email</span>
              <span class="account-detail-value">{{ customer.email }}</span>
            </div>
            {% if customer.phone %}
              <div class="account-detail-row">
                <span class="account-detail-label">Phone</span>
                <span class="account-detail-value">{{ customer.phone }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Account",
    "settings": []
  }
{% endschema %}
