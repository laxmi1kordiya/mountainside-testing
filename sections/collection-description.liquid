{%- comment -%} Resolve extra_collection metaobject (handle = path + filtered query) {%- endcomment -%}
{%- assign current_page_url = content_for_header | split: '"pageurl":"' | last | split: '"' | first | url_decode -%}
{%- assign url_parts = current_page_url | split: '?' -%}
{%- assign current_query_string = url_parts[1] | replace: '\u0026', '&' -%}
{%- assign cleaned_query = '' -%}
{%- assign query_pairs = current_query_string | split: '&' -%}
{%- assign first_kept = true -%}
{%- for pair in query_pairs -%}
  {%- assign pair_key = pair | split: '=' | first -%}
  {%- unless pair_key == '_fd' or pair_key == 'pb' or pair_key == '_pos' or pair_key == '_psq' or pair_key == '_ss' or pair_key == '_v' -%}
    {%- if first_kept -%}
      {%- assign cleaned_query = request.path | append: '?' | append: pair -%}
      {%- assign first_kept = false -%}
    {%- else -%}
      {%- assign cleaned_query = cleaned_query | append: '&' | append: pair -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- if cleaned_query != blank -%}
  {%- assign extra_collection_handle = cleaned_query
    | remove: '/collections/'
    | replace: '/', '-'
    | replace: '?', '-'
    | replace: '.', '-'
    | replace: '=', '-'
  -%}
{%- else -%}
  {%- assign extra_collection_handle = request.path
    | remove: '/collections/'
    | replace: '/', '-'
  -%}
{%- endif -%}
{%- assign extra_collection = shop.metaobjects.extra_collection[extra_collection_handle] -%}
{%- assign extra_collection_description = extra_collection.collection_description -%}

{% if extra_collection != blank and extra_collection_description != blank %}
  <div class="collection-description-section">
    <div class="collection-description-section__inner rte">
      {{ extra_collection_description }}
    </div>
  </div>
{% elsif collection.description != blank %}
  <div class="collection-description-section">
    <div class="collection-description-section__inner rte">
      {% if collection.handle == 'nurses-fashion-products' %}
        {{ collection.description
          | replace: '<h1></h1>', ''
          | replace: '<h1> </h1>', ''
        }}
      {% else %}
        {{ collection.description }}
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Collection Description",
  "class": "collection-description--section",
  "limit": 1,
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 600,
      "max": 1400,
      "step": 50,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection Description"
    }
  ]
}
{% endschema %}

{% style %}
  .collection-description-section {
    width: 100%;
  }
  .collection-description-section__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
  }
{% endstyle %}
