<section
  class="vendor-showcase-section"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: 5px;
    padding-bottom: 10px;
  "
>
  <div class="vendor-showcase-container">
    {% if section.settings.title != blank %}
      <div class="vendor-showcase-header">
        <h2 class="vendor-showcase-title" style="
          color: {{ section.settings.title_color }};
          font-size: {{ section.settings.title_size }}px;
          text-align: {{ section.settings.title_alignment }};
        ">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {% endif %}

    <div class="vendor-showcase-wrapper" data-scroll-speed="{{ section.settings.scroll_speed }}">
      <div class="vendor-showcase-track">
        {% for block in section.blocks %}
          <div class="vendor-showcase-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a class="vendor-showcase-link" href="{{ block.settings.link }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {% endif %}

            <div class="vendor-showcase-image-container">
              {% if block.settings.bw_image %}
                <img
                  class="vendor-showcase-image logo-bw"
                  src="{{ block.settings.bw_image | image_url: width: 500 }}"
                  alt="{{ block.settings.bw_image.alt | default: block.settings.vendor_name | default: 'Vendor logo' }}"
                  loading="eager"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder--image logo-bw' }}
              {% endif %}

              {% if block.settings.color_image %}
                <img
                  class="vendor-showcase-image logo-color"
                  src="{{ block.settings.color_image | image_url: width: 500 }}"
                  alt="{{ block.settings.color_image.alt | default: block.settings.vendor_name | default: 'Vendor logo' }}"
                  loading="eager"
                >
              {% endif %}
            </div>

            {% if block.settings.vendor_name != blank %}
              <p class="vendor-showcase-name" style="color: {{ section.settings.name_color }}; font-size: {{ section.settings.name_size }}px;">
                {{ block.settings.vendor_name | escape }}
              </p>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}

        {%- comment -%} Duplicate items 3 times for seamless infinite scroll - ensures always filled {%- endcomment -%}
        {% for i in (1..3) %}
          {% for block in section.blocks %}
            <div class="vendor-showcase-item vendor-showcase-item--clone" aria-hidden="true">
              {% if block.settings.link != blank %}
                <a class="vendor-showcase-link" href="{{ block.settings.link }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %} tabindex="-1">
              {% endif %}

              <div class="vendor-showcase-image-container">
                {% if block.settings.bw_image %}
                  <img
                    class="vendor-showcase-image logo-bw"
                    src="{{ block.settings.bw_image | image_url: width: 500 }}"
                    alt="{{ block.settings.bw_image.alt | default: block.settings.vendor_name | default: 'Vendor logo' }}"
                    loading="eager"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder--image logo-bw' }}
                {% endif %}

                {% if block.settings.color_image %}
                  <img
                    class="vendor-showcase-image logo-color"
                    src="{{ block.settings.color_image | image_url: width: 500 }}"
                    alt="{{ block.settings.color_image.alt | default: block.settings.vendor_name | default: 'Vendor logo' }}"
                    loading="eager"
                  >
                {% endif %}
              </div>

              {% if block.settings.vendor_name != blank %}
                <p class="vendor-showcase-name" style="color: {{ section.settings.name_color }}; font-size: {{ section.settings.name_size }}px;">
                  {{ block.settings.vendor_name | escape }}
                </p>
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .vendor-showcase-section {
    width: 100%;
    overflow: hidden;
  }

  .vendor-showcase-container {
    max-width: 100%;
    margin: 0 auto;
  }

  .vendor-showcase-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    margin-bottom: 5px;
  }

  .vendor-showcase-title {
    margin: 0;
    font-weight: 600;
  }

  .vendor-showcase-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .vendor-showcase-track {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.logo_gap }}px;
    width: max-content;
    animation: vendorScroll {{ section.settings.scroll_speed }}s linear infinite;
    /* Ensure content is visible immediately */
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* Ensure logos are visible instantly without delay */
  .vendor-showcase-image.logo-bw {
    visibility: visible !important;
  }

  .vendor-showcase-item {
    visibility: visible !important;
  }

  .vendor-showcase-wrapper:hover .vendor-showcase-track {
    animation-play-state: paused;
  }

  @keyframes vendorScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }

  .vendor-showcase-item {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vendor-showcase-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .vendor-showcase-image-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .vendor-showcase-image {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .logo-bw {
    opacity: 1;
  }

  .logo-color {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  .vendor-showcase-image-container:hover .logo-bw {
    opacity: 0;
  }

  .vendor-showcase-image-container:hover .logo-color {
    opacity: 1;
  }

  .vendor-showcase-image-container:hover {
    transform: scale(1.05);
  }

  .vendor-showcase-name {
    margin-top: 5px;
    margin-bottom: 0;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .vendor-showcase-item:hover .vendor-showcase-name {
    color: {{ section.settings.name_hover_color }} !important;
  }

  /* Placeholder styling */
  .vendor-showcase-image-container .placeholder--image {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    opacity: 0.5;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 767px) {
    .vendor-showcase-header {
      padding: 0 15px;
      margin-bottom: {{ section.settings.header_spacing | times: 0.7 | round }}px;
    }

    .vendor-showcase-title {
      font-size: calc({{ section.settings.title_size }}px * 0.75) !important;
    }

    .vendor-showcase-subtitle {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.85) !important;
    }

    .vendor-showcase-track {
      gap: {{ section.settings.logo_gap | times: 0.6 | round }}px;
    }

    .vendor-showcase-image {
      width: {{ section.settings.mobile_logo_width }}px !important;
      height: {{ section.settings.mobile_logo_height }}px !important;
    }

    .vendor-showcase-name {
      font-size: calc({{ section.settings.name_size }}px * 0.85) !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrappers = document.querySelectorAll('.vendor-showcase-wrapper');

    wrappers.forEach(function(wrapper) {
      const track = wrapper.querySelector('.vendor-showcase-track');
      if (!track) return;

      // Check if we need more clones for seamless scrolling
      const items = track.querySelectorAll('.vendor-showcase-item:not(.vendor-showcase-item--clone)');
      const clones = track.querySelectorAll('.vendor-showcase-item--clone');

      // Ensure the cloned content is at least as wide as the viewport
      const wrapperWidth = wrapper.offsetWidth;
      const itemsWidth = Array.from(items).reduce((acc, item) => acc + item.offsetWidth + parseInt(getComputedStyle(track).gap || 0), 0);

      if (itemsWidth < wrapperWidth && items.length > 0) {
        // Clone more items if needed
        const clonesNeeded = Math.ceil(wrapperWidth / itemsWidth);
        for (let i = 1; i < clonesNeeded; i++) {
          items.forEach(function(item) {
            const clone = item.cloneNode(true);
            clone.classList.add('vendor-showcase-item--clone');
            clone.setAttribute('aria-hidden', 'true');
            const links = clone.querySelectorAll('a');
            links.forEach(link => link.setAttribute('tabindex', '-1'));
            track.appendChild(clone);
          });
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Vendor Showcase",
  "class": "vendor-showcase--section",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Title & Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Vendors"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted brands we work with"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Space Below Header",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Background & Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Space Between Logos",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Logo Size"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 100,
      "max": 350,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Vendor Name Styling"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "name_hover_color",
      "label": "Name Hover Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Scroll Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "info": "Lower = faster, Higher = slower"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile Logo Width",
      "min": 80,
      "max": 250,
      "step": 10,
      "default": 150,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_logo_height",
      "label": "Mobile Logo Height",
      "min": 40,
      "max": 120,
      "step": 10,
      "default": 70,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "settings": [
        {
          "type": "text",
          "id": "vendor_name",
          "label": "Vendor Name",
          "info": "Displayed below the logo"
        },
        {
          "id": "bw_image",
          "type": "image_picker",
          "label": "Black & White Logo",
          "info": "Displayed by default (grayscale/monochrome version)"
        },
        {
          "id": "color_image",
          "type": "image_picker",
          "label": "Color Logo",
          "info": "Displayed on hover (colorful version)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vendor Showcase",
      "category": "Image",
      "blocks": [
        { "type": "vendor" },
        { "type": "vendor" },
        { "type": "vendor" },
        { "type": "vendor" },
        { "type": "vendor" },
        { "type": "vendor" }
      ]
    }
  ]
}
{% endschema %}
