<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-announcement">
</script>

{% assign show_everywhere = false %}
{% assign homepage_only = false %}
{% assign within_window = true %}

{% comment %} Determine visibility scope {% endcomment %}
{% if
  section.settings.show_announcement and
  section.settings.homepage_announcement == false
%}
  {% assign show_everywhere = true %}
{% endif %}

{% if
  section.settings.show_announcement and
  section.settings.homepage_announcement and
  template == 'index'
%}
  {% assign homepage_only = true %}
{% endif %}

{% comment %} Check campaign window if enabled {% endcomment %}
{% if section.settings.limit_to_campaign_window %}
  {% assign now_timestamp = 'now' | date: "%s" | plus: 0 %}
  {% assign start_timestamp = section.settings.bfcm_start | date: "%s" | plus: 0 %}
  {% assign end_timestamp = section.settings.bfcm_end | date: "%s" | plus: 0 %}

  {% if now_timestamp >= start_timestamp and now_timestamp <= end_timestamp %}
    {% assign within_window = true %}
  {% else %}
    {% assign within_window = false %}
  {% endif %}
{% endif %}

{% comment %} Check if we should show the bar {% endcomment %}
{% assign should_show = false %}
{% if show_everywhere or homepage_only %}
  {% assign should_show = true %}
{% endif %}

{% comment %} Render only if all conditions met {% endcomment %}
{% if section.settings.enable_on_this_theme %}
  {% if should_show and within_window %}
  {% if
    section.settings.announcement_text != blank or
    section.settings.announcement_text_mobile != blank
  %}
    <div
      class="
        announcement-bar
        {% if section.settings.announcement_text == blank and section.settings.announcement_text_mobile != blank %}
          only-mobile
        {% endif %}
      "
      style="
        color: {{ section.settings.announcement_color }};
        background: {{ section.settings.announcement_background }};
      ">
      {% if section.settings.announcement_link != blank %}
        <a
          class="announcement-bar-link"
          href="{{ section.settings.announcement_link }}"
          ></a>
      {% endif %}

      {% if section.settings.announcement_text != blank %}
        <div class="announcement-bar-text">
          {{ section.settings.announcement_text }}
        </div>
      {% endif %}

      <div class="announcement-bar-text-mobile">
        {% if section.settings.announcement_text_mobile != blank %}
          {{ section.settings.announcement_text_mobile }}
        {% else %}
          {{ section.settings.announcement_text }}
        {% endif %}
      </div>
    </div>
  {% endif %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "site-announcement",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement"
    },
    {
      "type": "checkbox",
      "id": "homepage_announcement",
      "label": "Show on home page only"
    },
    {
      "id": "announcement_text",
      "type": "textarea",
      "label": "Text",
      "default": "BLACK FRIDAY: Save 10% on all products! Use code BF10 at checkout."
    },
    {
      "id": "announcement_text_mobile",
      "type": "textarea",
      "label": "Text (mobile)",
      "info": "Use this option if you want to display alternate text in mobile. Recommended for shortening announcement text to make suitable for mobile.",
      "default": "Save 10% with code BF10"
    },
    {
      "id": "announcement_link",
      "type": "url",
      "label": "Link",
      "info": "Recommended: /discount/BLACKFRIDAY10?redirect=%2Fcollections%2Fall (auto-applies discount and redirects to All Products)"
    },
    {
      "id": "announcement_color",
      "type": "color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "id": "announcement_background",
      "type": "color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Campaign Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_on_this_theme",
      "label": "Enable on this theme only",
      "default": false,
      "info": "Use this to show the announcement only on the dev theme until you're ready to go live"
    },
    {
      "type": "checkbox",
      "id": "limit_to_campaign_window",
      "label": "Limit to campaign window",
      "default": true,
      "info": "Only show the announcement between the start and end dates below"
    },
    {
      "type": "text",
      "id": "bfcm_start",
      "label": "Campaign start date",
      "default": "2025-11-11 00:00 -0500",
      "info": "Format: YYYY-MM-DD HH:MM ±HHMM (e.g., 2025-11-11 00:00 -0500 for midnight ET)"
    },
    {
      "type": "text",
      "id": "bfcm_end",
      "label": "Campaign end date",
      "default": "2025-12-01 23:59 -0500",
      "info": "Format: YYYY-MM-DD HH:MM ±HHMM (Cyber Monday end)"
    }
  ]
}

{% endschema %}