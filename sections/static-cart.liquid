<script>
// Product Recommendations Dismiss Functionality
// This is a separate script that does not interfere with existing JS
(function() {
  'use strict';

  // Session storage key for dismissed products
  const DISMISSED_PRODUCTS_KEY = 'cart_dismissed_recommendations';

  // Get dismissed products from session storage
  function getDismissedProducts() {
    try {
      const stored = sessionStorage.getItem(DISMISSED_PRODUCTS_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  }

  // Save dismissed products to session storage
  function saveDismissedProducts(productIds) {
    try {
      sessionStorage.setItem(DISMISSED_PRODUCTS_KEY, JSON.stringify(productIds));
    } catch (e) {
      console.error('Error saving dismissed products:', e);
    }
  }

  // Add a product to dismissed list
  function addDismissedProduct(productId) {
    const dismissed = getDismissedProducts();
    if (!dismissed.includes(productId)) {
      dismissed.push(productId);
      saveDismissedProducts(dismissed);
    }
  }

  // Check if a product is dismissed
  function isProductDismissed(productId) {
    const dismissed = getDismissedProducts();
    return dismissed.includes(productId);
  }

  // Find the next available hidden product in a container
  function findNextAvailableProduct(container) {
    const dismissed = getDismissedProducts();
    const hiddenItems = container.querySelectorAll('.cart-recommendation-item.cart-recommendation-hidden');

    for (const item of hiddenItems) {
      const productId = item.getAttribute('data-product-id');
      if (!dismissed.includes(productId)) {
        return item;
      }
    }
    return null;
  }

  // Count visible (non-hidden, non-dismissed) items
  function countVisibleItems(container) {
    const items = container.querySelectorAll('.cart-recommendation-item:not(.cart-recommendation-hidden)');
    let count = 0;
    const dismissed = getDismissedProducts();

    items.forEach(item => {
      const productId = item.getAttribute('data-product-id');
      if (!dismissed.includes(productId)) {
        count++;
      }
    });
    return count;
  }

  // Handle dismiss button click
  function handleDismiss(e) {
    const dismissBtn = e.target.closest('.cart-recommendation-dismiss-btn');
    if (!dismissBtn) return;

    e.preventDefault();
    e.stopPropagation();

    const item = dismissBtn.closest('.cart-recommendation-item');
    if (!item) return;

    const productId = dismissBtn.getAttribute('data-dismiss-product');
    const container = item.closest('.cart-recommendations-list');

    if (!productId || !container) return;

    // Add to dismissed list
    addDismissedProduct(productId);

    // Add dismissing animation
    item.classList.add('cart-recommendation-dismissing');

    // After animation, hide and show replacement
    setTimeout(function() {
      // Hide the dismissed item
      item.classList.add('cart-recommendation-hidden');
      item.classList.remove('cart-recommendation-dismissing');

      // Find and show replacement
      const replacement = findNextAvailableProduct(container);
      if (replacement) {
        replacement.classList.remove('cart-recommendation-hidden');
        replacement.classList.add('cart-recommendation-showing');

        // Remove animation class after it completes
        setTimeout(function() {
          replacement.classList.remove('cart-recommendation-showing');
        }, 300);
      }

      // Sync with other container (mobile/desktop)
      syncContainers(productId);
    }, 250);
  }

  // Sync dismissal across mobile and desktop containers
  function syncContainers(dismissedProductId) {
    const containers = document.querySelectorAll('.cart-product-recommendations');

    containers.forEach(container => {
      const list = container.querySelector('.cart-recommendations-list');
      if (!list) return;

      // Find and hide the dismissed product in this container
      const itemToHide = list.querySelector('.cart-recommendation-item[data-product-id="' + dismissedProductId + '"]');
      if (itemToHide && !itemToHide.classList.contains('cart-recommendation-hidden')) {
        itemToHide.classList.add('cart-recommendation-hidden');

        // Show a replacement
        const replacement = findNextAvailableProduct(list);
        if (replacement) {
          replacement.classList.remove('cart-recommendation-hidden');
        }
      }
    });
  }

  // Initialize - hide any previously dismissed products
  function initDismissedProducts() {
    const dismissed = getDismissedProducts();
    if (dismissed.length === 0) return;

    const containers = document.querySelectorAll('.cart-recommendations-list');

    containers.forEach(container => {
      const items = container.querySelectorAll('.cart-recommendation-item');
      let visibleCount = 0;
      const maxVisible = 6;

      items.forEach(item => {
        const productId = item.getAttribute('data-product-id');

        if (dismissed.includes(productId)) {
          // This product was previously dismissed - hide it
          item.classList.add('cart-recommendation-hidden');
        } else if (visibleCount < maxVisible) {
          // Show this product if we need more visible items
          item.classList.remove('cart-recommendation-hidden');
          visibleCount++;
        } else {
          // Already have enough visible items - keep this one hidden for replacements
          item.classList.add('cart-recommendation-hidden');
        }
      });
    });
  }

  // Main initialization
  function init() {
    // Apply previously dismissed products
    initDismissedProducts();

    // Listen for dismiss button clicks
    document.addEventListener('click', handleDismiss);
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<script>
// Cart Recommended Products Carousel - mirrors best-selling carousel behavior
(function() {
  'use strict';

  var carousel = document.querySelector('[data-cart-carousel]');
  if (!carousel) return;

  var trackContainer = carousel.querySelector('[data-carousel-track-container]');
  var track = carousel.querySelector('[data-carousel-track]');
  var prevBtn = carousel.querySelector('[data-carousel-prev]');
  var nextBtn = carousel.querySelector('[data-carousel-next]');
  var cards = track.querySelectorAll('[data-carousel-card]');

  if (!track || !trackContainer || cards.length === 0) return;

  var AUTOPLAY_SPEED = 3000;
  var cardWidth = cards[0].offsetWidth + 12; // card width + gap

  var autoplayInterval;
  var isHovering = false;
  var scrollTimeout;

  function recalculateDimensions() {
    cardWidth = cards[0].offsetWidth + 12;
    updateArrowVisibility();
  }

  // Update arrow visibility based on scroll position (same as best-selling)
  function updateArrowVisibility() {
    var scrollLeft = trackContainer.scrollLeft;
    var maxScroll = trackContainer.scrollWidth - trackContainer.offsetWidth;

    if (prevBtn) {
      if (scrollLeft <= 5) {
        prevBtn.style.opacity = '0';
        prevBtn.style.pointerEvents = 'none';
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.pointerEvents = 'auto';
      }
    }

    if (nextBtn) {
      if (scrollLeft >= maxScroll - 5) {
        nextBtn.style.opacity = '0';
        nextBtn.style.pointerEvents = 'none';
      } else {
        nextBtn.style.opacity = '1';
        nextBtn.style.pointerEvents = 'auto';
      }
    }
  }

  function scrollNext() {
    trackContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
  }

  function scrollPrev() {
    trackContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
  }

  function startAutoplay() {
    if (!isHovering) {
      stopAutoplay();
      autoplayInterval = setInterval(function() {
        if (trackContainer.scrollLeft + trackContainer.offsetWidth >= trackContainer.scrollWidth - 10) {
          trackContainer.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          scrollNext();
        }
      }, AUTOPLAY_SPEED);
    }
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Pause on hover - same pattern as best-selling
  function handleMouseEnter() {
    isHovering = true;
    stopAutoplay();
  }

  function handleMouseLeave() {
    isHovering = false;
    startAutoplay();
  }

  carousel.addEventListener('mouseenter', handleMouseEnter);
  carousel.addEventListener('mouseleave', handleMouseLeave);
  trackContainer.addEventListener('mouseenter', handleMouseEnter);
  trackContainer.addEventListener('mouseleave', handleMouseLeave);
  track.addEventListener('mouseenter', handleMouseEnter);
  track.addEventListener('mouseleave', handleMouseLeave);

  // Pause on touch for mobile
  trackContainer.addEventListener('touchstart', function() {
    isHovering = true;
    stopAutoplay();
  }, { passive: true });

  trackContainer.addEventListener('touchend', function() {
    setTimeout(function() {
      isHovering = false;
      if (!isHovering) {
        startAutoplay();
      }
    }, 3000);
  }, { passive: true });

  // Arrow clicks
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) { e.preventDefault(); scrollPrev(); });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) { e.preventDefault(); scrollNext(); });
  }

  // Update arrows on scroll (covers finger/trackpad/arrow scroll)
  trackContainer.addEventListener('scroll', function() {
    updateArrowVisibility();
  }, { passive: true });

  // Restart autoplay when user stops scrolling (if not hovering)
  trackContainer.addEventListener('scroll', function() {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(function() {
      if (!isHovering) {
        startAutoplay();
      }
    }, 3000);
  }, { passive: true });

  // Quantity selector - increase, decrease, input validation
  carousel.addEventListener('click', function(e) {
    var increaseBtn = e.target.closest('[data-cart-carousel-qty-increase]');
    var decreaseBtn = e.target.closest('[data-cart-carousel-qty-decrease]');

    if (increaseBtn) {
      var input = increaseBtn.closest('.cart-carousel__qty-selector').querySelector('[data-cart-carousel-qty-value]');
      var val = parseInt(input.value) || 1;
      input.value = val + 1;
    }

    if (decreaseBtn) {
      var input = decreaseBtn.closest('.cart-carousel__qty-selector').querySelector('[data-cart-carousel-qty-value]');
      var val = parseInt(input.value) || 1;
      if (val > 1) input.value = val - 1;
    }
  });

  // Validate qty input on change
  carousel.addEventListener('change', function(e) {
    if (e.target.matches('[data-cart-carousel-qty-value]')) {
      var val = parseInt(e.target.value);
      if (!val || val < 1) e.target.value = 1;
    }
  });

  // Add to Cart functionality - reads quantity from selector
  carousel.addEventListener('click', function(e) {
    var addBtn = e.target.closest('.cart-carousel__btn--atc');
    if (!addBtn) return;

    e.preventDefault();
    var variantId = addBtn.getAttribute('data-variant-id');
    if (!variantId) return;

    // Get quantity from the sibling qty selector
    var card = addBtn.closest('.cart-carousel__buttons');
    var qtyInput = card ? card.querySelector('[data-cart-carousel-qty-value]') : null;
    var quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

    addBtn.disabled = true;
    var originalHTML = addBtn.innerHTML;
    addBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="10" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="0.6s" repeatCount="indefinite"/></circle></svg>';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId), quantity: quantity })
    })
    .then(function(res) {
      if (!res.ok) {
        return res.json().then(function(err) { throw new Error(err.description || 'Could not add item'); });
      }
      return res.json();
    })
    .then(function() {
      addBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Added';

      // Fetch updated cart and update UI without reload
      window.skipDOMCalculations = true;
      setTimeout(function() {
        Promise.all([
          fetch('/cart.js').then(res => res.json()),
          fetch('/cart').then(res => res.text())
        ])
        .then(([cart, cartPageHtml]) => {
          // Format money using Shopify's formatter with consistent formatting
          var formattedTotal = (window.Shopify && window.Shopify.formatMoney)
            ? window.Shopify.formatMoney(cart.total_price, window.Shopify.money_format || '${{amount}}').replace(/\$\s+/, '$')
            : '$' + (cart.total_price / 100).toFixed(2);

          // Update subtotal displays
          var subtotalElements = document.querySelectorAll('[data-cart-subtotal], [data-cart-total]');
          subtotalElements.forEach(el => {
            var priceSpan = el.querySelector('span');
            if (priceSpan) {
              priceSpan.textContent = formattedTotal;
            } else {
              el.textContent = formattedTotal;
            }
          });

          // Update cart items list from fetched page
          var parser = new DOMParser();
          var newPage = parser.parseFromString(cartPageHtml, 'text/html');
          var newItemsList = newPage.querySelector('[data-cart-item-list]');
          if (newItemsList) {
            var currentItemsList = document.querySelector('[data-cart-item-list]');
            if (currentItemsList) {
              currentItemsList.innerHTML = newItemsList.innerHTML;
            }
          }

          // Dispatch cart updated event for shipping bar
          var event = new CustomEvent('cart:updated', { detail: { total_price: cart.total_price } });
          document.dispatchEvent(event);

          // Reset button after 1.5 seconds
          setTimeout(function() {
            addBtn.innerHTML = originalHTML;
            addBtn.disabled = false;
            window.skipDOMCalculations = false; // Re-enable DOM calculations
          }, 1500);
        })
        .catch(err => {
          console.error('Error updating cart display:', err);
          addBtn.innerHTML = originalHTML;
          addBtn.disabled = false;
          window.skipDOMCalculations = false; // Re-enable DOM calculations
        });
      }, 300);
    })
    .catch(function(err) {
      addBtn.innerHTML = originalHTML;
      addBtn.disabled = false;
      window.skipDOMCalculations = false; // Re-enable DOM calculations
      if (err && err.message) alert(err.message);
    });
  });

  // Recalculate on resize
  var resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(recalculateDimensions, 250);
  });

  // Initialize
  updateArrowVisibility();
  startAutoplay();
})();
</script>

<script>
// Recently Viewed Products Carousel
(function() {
  'use strict';

  var section = document.querySelector('[data-cart-recently-viewed]');
  if (!section) return;

  var trackContainer = section.querySelector('[data-rv-track-container]');
  var track = section.querySelector('[data-rv-track]');
  var prevBtn = section.querySelector('[data-rv-prev]');
  var nextBtn = section.querySelector('[data-rv-next]');

  if (!track || !trackContainer) return;

  // Read recently viewed handles from localStorage
  // Format: array of objects { handle: "product-handle", timestamp: 123456 }
  var raw = localStorage.getItem('pxu-recentlyViewed-1');
  if (!raw) return;

  var entries = [];
  try {
    entries = JSON.parse(raw);
  } catch (e) {
    return;
  }

  if (!Array.isArray(entries) || entries.length === 0) return;

  // Extract handles from objects
  var handles = entries.map(function(entry) {
    return typeof entry === 'string' ? entry : (entry && entry.handle ? entry.handle : null);
  }).filter(Boolean);

  if (handles.length === 0) return;

  // Get cart item handles to filter out products already in cart
  var cartHandles = {};
  var cartItems = document.querySelectorAll('[data-cartitem]');
  cartItems.forEach(function(item) {
    var link = item.querySelector('a[href*="/products/"]');
    if (link) {
      var match = link.getAttribute('href').match(/\/products\/([^?#/]+)/);
      if (match) cartHandles[match[1]] = true;
    }
  });

  // Filter out cart items
  var filteredHandles = handles.filter(function(h) {
    return !cartHandles[h];
  });

  if (filteredHandles.length === 0) return;

  // Fetch product data and build cards
  var fetches = filteredHandles.map(function(handle) {
    return fetch('/products/' + encodeURIComponent(handle) + '.js')
      .then(function(res) {
        if (!res.ok) return null;
        return res.json();
      })
      .catch(function() { return null; });
  });

  Promise.all(fetches).then(function(products) {
