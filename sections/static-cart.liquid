1.1 2.7 1.7.3.2.7.4 1 .6.9.5 1.8 1.1 2.7 1.6.3.2.6.3.9.5 1 .6 2.1 1.2 3.1 1.7.2.1.5.3.7.4 1.1.6 2.2 1.2 3.3 1.8.1 0 .2.1.3.2 1.2.6 2.4 1.2 3.6 1.8h.1c2.3 1.1 4.6 2.2 6.9 3.2.5.1.9.3 1.3.5z" fill="#dfdfdf"/></svg></div>')
            + '</a>' +
          '</div>' +
          '<div class="cart-recently-viewed__info">' +
            '<h4 class="cart-recently-viewed__product-title">' +
              '<a href="/products/' + product.handle + '">' + product.title + '</a>' +
            '</h4>' +
            '<div class="cart-recently-viewed__price">' +
              (hasDiscount ? '<span class="cart-recently-viewed__price--compare">' + formatMoney(variant.compare_at_price) + '</span>' : '') +
              '<span class="cart-recently-viewed__price--current">' + formatMoney(variant.price) + '</span>' +
            '</div>' +
            '<div class="cart-recently-viewed__buttons">' +
              '<div class="cart-recently-viewed__qty-selector" data-rv-qty>' +
                '<button type="button" class="cart-recently-viewed__qty-btn" data-rv-qty-decrease>-</button>' +
                '<input type="number" class="cart-recently-viewed__qty-input" data-rv-qty-value value="1" min="1">' +
                '<button type="button" class="cart-recently-viewed__qty-btn" data-rv-qty-increase>+</button>' +
              '</div>' +
              '<button type="button" class="cart-recently-viewed__btn cart-recently-viewed__btn--atc" data-variant-id="' + variant.id + '">' +
                '<span>Add to Cart</span>' +
              '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

      track.insertAdjacentHTML('beforeend', cardHTML);
    });

    // Show section
    section.style.display = '';

    // Initialize carousel
    initCarousel();
  });

  function formatMoney(cents) {
    var result;
    if (window.Shopify && window.Shopify.formatMoney) {
      result = window.Shopify.formatMoney(cents, window.Shopify.money_format || '${{amount}}');
    } else {
      result = '$' + (cents / 100).toFixed(2);
    }
    // Remove space between $ and amount to match recommended carousel
    return result.replace(/\$\s+/, '$');
  }

  function initCarousel() {
    var cards = track.querySelectorAll('[data-rv-card]');
    if (cards.length === 0) return;

    var AUTOPLAY_SPEED = 3000;
    var cardWidth = cards[0].offsetWidth + 12;
    var autoplayInterval;
    var isHovering = false;
    var scrollTimeout;

    function recalculateDimensions() {
      cardWidth = cards[0].offsetWidth + 12;
      updateArrowVisibility();
    }

    function updateArrowVisibility() {
      var scrollLeft = trackContainer.scrollLeft;
      var maxScroll = trackContainer.scrollWidth - trackContainer.offsetWidth;

      if (prevBtn) {
        if (scrollLeft <= 5) {
          prevBtn.style.opacity = '0';
          prevBtn.style.pointerEvents = 'none';
        } else {
          prevBtn.style.opacity = '1';
          prevBtn.style.pointerEvents = 'auto';
        }
      }

      if (nextBtn) {
        if (scrollLeft >= maxScroll - 5) {
          nextBtn.style.opacity = '0';
          nextBtn.style.pointerEvents = 'none';
        } else {
          nextBtn.style.opacity = '1';
          nextBtn.style.pointerEvents = 'auto';
        }
      }
    }

    function scrollNext() {
      trackContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
    }

    function scrollPrev() {
      trackContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    }

    function startAutoplay() {
      if (!isHovering) {
        stopAutoplay();
        autoplayInterval = setInterval(function() {
          if (trackContainer.scrollLeft + trackContainer.offsetWidth >= trackContainer.scrollWidth - 10) {
            trackContainer.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            scrollNext();
          }
        }, AUTOPLAY_SPEED);
      }
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    function handleMouseEnter() {
      isHovering = true;
      stopAutoplay();
    }

    function handleMouseLeave() {
      isHovering = false;
      startAutoplay();
    }

    section.addEventListener('mouseenter', handleMouseEnter);
    section.addEventListener('mouseleave', handleMouseLeave);
    trackContainer.addEventListener('mouseenter', handleMouseEnter);
    trackContainer.addEventListener('mouseleave', handleMouseLeave);
    track.addEventListener('mouseenter', handleMouseEnter);
    track.addEventListener('mouseleave', handleMouseLeave);

    trackContainer.addEventListener('touchstart', function() {
      isHovering = true;
      stopAutoplay();
    }, { passive: true });

    trackContainer.addEventListener('touchend', function() {
      setTimeout(function() {
        isHovering = false;
        if (!isHovering) startAutoplay();
      }, 3000);
    }, { passive: true });

    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) { e.preventDefault(); scrollPrev(); });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) { e.preventDefault(); scrollNext(); });
    }

    trackContainer.addEventListener('scroll', function() {
      updateArrowVisibility();
    }, { passive: true });

    trackContainer.addEventListener('scroll', function() {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() {
        if (!isHovering) startAutoplay();
      }, 3000);
    }, { passive: true });

    // Quantity selector
    section.addEventListener('click', function(e) {
      var increaseBtn = e.target.closest('[data-rv-qty-increase]');
      var decreaseBtn = e.target.closest('[data-rv-qty-decrease]');

      if (increaseBtn) {
        var input = increaseBtn.closest('.cart-recently-viewed__qty-selector').querySelector('[data-rv-qty-value]');
        var val = parseInt(input.value) || 1;
        input.value = val + 1;
      }

      if (decreaseBtn) {
        var input = decreaseBtn.closest('.cart-recently-viewed__qty-selector').querySelector('[data-rv-qty-value]');
        var val = parseInt(input.value) || 1;
        if (val > 1) input.value = val - 1;
      }
    });

    section.addEventListener('change', function(e) {
      if (e.target.matches('[data-rv-qty-value]')) {
        var val = parseInt(e.target.value);
        if (!val || val < 1) e.target.value = 1;
      }
    });

    // Add to Cart
    section.addEventListener('click', function(e) {
      var addBtn = e.target.closest('.cart-recently-viewed__btn--atc');
      if (!addBtn) return;

      e.preventDefault();
      var variantId = addBtn.getAttribute('data-variant-id');
      if (!variantId) return;

      var card = addBtn.closest('.cart-recently-viewed__buttons');
      var qtyInput = card ? card.querySelector('[data-rv-qty-value]') : null;
      var quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

      addBtn.disabled = true;
      var originalHTML = addBtn.innerHTML;
      addBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="10" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="0.6s" repeatCount="indefinite"/></circle></svg>';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId), quantity: quantity })
      })
      .then(function(res) {
        if (!res.ok) {
          return res.json().then(function(err) { throw new Error(err.description || 'Could not add item'); });
        }
        return res.json();
      })
      .then(function() {
        addBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Added';

        // Fetch updated cart and update UI without reload
        setTimeout(function() {
          Promise.all([
            fetch('/cart.js').then(res => res.json()),
            fetch('/cart').then(res => res.text())
          ])
          .then(([cart, cartPageHtml]) => {
            // Update subtotal displays using centralized function
            if (window.updateAllSubtotals) {
              window.updateAllSubtotals(cart.total_price);
            }

            // Update cart items list from fetched page
            var parser = new DOMParser();
            var newPage = parser.parseFromString(cartPageHtml, 'text/html');
            var newItemsList = newPage.querySelector('[data-cart-item-list]');
            if (newItemsList) {
              var currentItemsList = document.querySelector('[data-cart-item-list]');
              if (currentItemsList) {
                currentItemsList.innerHTML = newItemsList.innerHTML;
              }
            }

            // Dispatch cart updated event for shipping bar
            var event = new CustomEvent('cart:updated', { detail: { total_price: cart.total_price } });
            document.dispatchEvent(event);

            // Ensure shipping bar gets the correct total (override any DOM calculations)
            setTimeout(function() {
              if (window.updateShippingBar) {
                window.updateShippingBar(cart.total_price);
              }
            }, 50);

            // Reset button after 1.5 seconds
            setTimeout(function() {
              addBtn.innerHTML = originalHTML;
              addBtn.disabled = false;
            }, 1500);
          })
          .catch(err => {
            console.error('Error updating cart display:', err);
            addBtn.innerHTML = originalHTML;
            addBtn.disabled = false;
          });
        }, 300);
      })
      .catch(function(err) {
        addBtn.innerHTML = originalHTML;
        addBtn.disabled = false;
        if (err && err.message) alert(err.message);
      });
    });

    var resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(recalculateDimensions, 250);
    });

    updateArrowVisibility();
    startAutoplay();
  }
})();
</script>