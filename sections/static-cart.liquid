<script>
/**
 * Updates cart line item totals in real-time when quantity changes
 */
(function() {
  'use strict';

  // Store unit prices for each cart item using data attributes
  function storeUnitPrices() {
    const cartItems = document.querySelectorAll('[data-cartitem]');

    cartItems.forEach(cartItem => {
      const lineTotalEl = cartItem.querySelector('[data-cartitem-total]');
      const qtyEl = cartItem.querySelector('[data-cartitem-quantity]');

      if (!lineTotalEl || !qtyEl) return;

      // Check if data-unit-price and data-original-unit-price are already set (from Liquid)
      let unitPriceCents = parseInt(cartItem.getAttribute('data-unit-price'));
      let originalUnitPriceCents = parseInt(cartItem.getAttribute('data-original-unit-price'));

      // If not already set, extract from displayed prices
      if (!unitPriceCents || isNaN(unitPriceCents)) {
        const currentQty = parseInt(qtyEl.value) || 1;
        const lineTotalText = lineTotalEl.textContent.trim();
        const lineTotalCents = parseMoney(lineTotalText);
        unitPriceCents = Math.round(lineTotalCents / currentQty);
        cartItem.setAttribute('data-unit-price', unitPriceCents);
      }

      // If original price not set, try to extract from DOM
      if (!originalUnitPriceCents || isNaN(originalUnitPriceCents)) {
        const originalLinePriceEl = cartItem.querySelector('.original-price');
        if (originalLinePriceEl) {
          const currentQty = parseInt(qtyEl.value) || 1;
          const originalLineTotalText = originalLinePriceEl.textContent.trim();
          const originalLineTotalCents = parseMoney(originalLineTotalText);
          originalUnitPriceCents = Math.round(originalLineTotalCents / currentQty);
          cartItem.setAttribute('data-original-unit-price', originalUnitPriceCents);
        }
      }
    });
  }

  // Parse money string to cents
  function parseMoney(moneyString) {
    const cleaned = moneyString.replace(/[^\d.,]/g, '');
    let number;

    if (cleaned.indexOf(',') > cleaned.indexOf('.')) {
      number = parseFloat(cleaned.replace(/\./g, '').replace(',', '.'));
    } else {
      number = parseFloat(cleaned.replace(/,/g, ''));
    }

    return Math.round((number || 0) * 100);
  }

  // Format cents to money string with consistent formatting (no spacing glitches)
  function formatMoney(cents) {
    const value = (cents / 100).toFixed(2);

    if (window.Shopify && window.Shopify.formatMoney) {
      const formatted = window.Shopify.formatMoney(cents, window.Shopify.money_format || '${{amount}}');
      // Strip any extra spaces between $ and amount for consistency
      return formatted.replace(/\$\s+/, '$');
    }

    return '$' + value;
  }

  // Update all subtotal elements reliably - make it globally accessible
  window.updateAllSubtotals = function(totalCents) {
    const value = (totalCents / 100).toFixed(2);
    const formattedTotal = window.Shopify && window.Shopify.formatMoney
      ? (function() {
          const formatted = window.Shopify.formatMoney(totalCents, window.Shopify.money_format || '${{amount}}');
          // Strip any extra spaces for consistent formatting
          return formatted.replace(/\$\s+/, '$');
        })()
      : '$' + value;

    // Update data-cart-subtotal elements
    document.querySelectorAll('[data-cart-subtotal]').forEach(el => {
      const span = el.querySelector('span');
      if (span) {
        span.textContent = formattedTotal;
      } else {
        el.textContent = formattedTotal;
      }
    });

    // Update data-cart-total elements
    document.querySelectorAll('[data-cart-total]').forEach(el => {
      const span = el.querySelector('span');
      if (span) {
        span.textContent = formattedTotal;
      } else {
        el.textContent = formattedTotal;
      }
    });
  };

  // Update line total for a cart item
  function updateLineTotal(cartItem, newQuantity) {
    const unitPrice = parseInt(cartItem.getAttribute('data-unit-price')) || 0;
    const originalUnitPrice = parseInt(cartItem.getAttribute('data-original-unit-price')) || 0;

    if (unitPrice <= 0) return; // Don't update if we don't have a valid unit price

    const qty = Math.max(1, parseInt(newQuantity) || 1);
    const lineTotalEl = cartItem.querySelector('[data-cartitem-total]');
    const originalLinePriceEl = cartItem.querySelector('.original-price');

    // Update final line total
    if (lineTotalEl) {
      const newLineTotal = unitPrice * qty;
      lineTotalEl.innerHTML = formatMoney(newLineTotal);
    }

    // Update original line price (crossed out) if applicable
    if (originalLinePriceEl && originalUnitPrice > 0) {
      const newOriginalTotal = originalUnitPrice * qty;
      originalLinePriceEl.innerHTML = formatMoney(newOriginalTotal);
    }
  }

  // Track the latest request to prevent out-of-order response issues
  let latestRequestTimestamp = 0;

  // Handle quantity change
  function handleQuantityChange(qtyInput) {
    const cartItem = qtyInput.closest('[data-cartitem]');
    if (!cartItem) return;

    const newQuantity = parseInt(qtyInput.value) || 0;
    const itemKey = cartItem.getAttribute('data-cartitem-key');
    const requestTimestamp = Date.now();
    latestRequestTimestamp = requestTimestamp;

    if (!itemKey) {
      // Fallback to local calculation only
      updateLineTotal(cartItem, newQuantity);
      return;
    }

    // Prevent DOM calculations while updating
    window.skipDOMCalculations = true;

    // Update line total immediately with correct calculation
    updateLineTotal(cartItem, newQuantity);

    // Send quantity change to server via Shopify AJAX API
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        id: itemKey,
        quantity: newQuantity
      })
    })
    .then(response => response.json())
    .then(cart => {
      // Fetch FRESH cart data from server for accurate totals
      return fetch('/cart.js').then(res => res.json());
    })
    .then(freshCart => {
      // Only process if this is the latest request (prevent out-of-order updates)
      if (requestTimestamp !== latestRequestTimestamp) {
        return; // Ignore stale responses
      }

      // Update subtotal displays from fresh cart data
      if (window.updateAllSubtotals) {
        window.updateAllSubtotals(freshCart.total_price);
      }

      // Update shipping bar from the SAME fresh cart data
      if (window.updateShippingBar) {
        window.updateShippingBar(freshCart.total_price);
      }

      // Dispatch event as confirmation
      var event = new CustomEvent('cart:updated', { detail: { total_price: freshCart.total_price } });
      document.dispatchEvent(event);

      // Only reset flag if this is still the latest request
      if (requestTimestamp === latestRequestTimestamp) {
        window.skipDOMCalculations = false; // Re-enable DOM calculations
      }
    })
    .catch(error => {
      console.error('Error updating cart quantity:', error);

      // Only reset flag if this is still the latest request
      if (requestTimestamp === latestRequestTimestamp) {
        window.skipDOMCalculations = false;
      }
    });
  }

  // Initialize - make globally accessible for re-initialization after item additions
  window.initCartLineUpdater = function initCartLineUpdater() {
    // Initialize the flag early to prevent DOM calculations during server updates
    if (!window.skipDOMCalculations) {
      window.skipDOMCalculations = false;
    }

    const cartItems = document.querySelectorAll('[data-cartitem]');

    if (cartItems.length > 0) {
      // Store initial unit prices
      storeUnitPrices();

      // Get the cart item list container for event delegation
      const cartItemList = document.querySelector('[data-cart-item-list]');
      if (!cartItemList) return;

      // Remove old listeners to prevent duplicate attachment
      // Clone and replace to remove all old event listeners
      const newCartItemList = cartItemList.cloneNode(false);

      // Only do this if we're actually attaching new listeners
      // Actually, we should use a different approach - attach listeners directly to the container
      // and handle event delegation to avoid cloning

      // Instead, use event delegation on the cart item list
      // Remove old listeners by cloning (this is the safest way to prevent duplicates)
      if (!window._cartListenerAttached) {
        // Listen for quantity changes on the cart item list
        cartItemList.addEventListener('change', function(event) {
          if (event.target.matches('[data-cartitem-quantity]')) {
            window.skipDOMCalculations = true;
            handleQuantityChange(event.target);
          }
        }, false);

        cartItemList.addEventListener('input', function(event) {
          if (event.target.matches('[data-cartitem-quantity]')) {
            window.skipDOMCalculations = true;
            handleQuantityChange(event.target);
          }
        }, false);

        // Handle quantity selector +/- buttons with event delegation
        cartItemList.addEventListener('click', function(event) {
          const minusBtn = event.target.closest('[data-quantity-minus]');
          const plusBtn = event.target.closest('[data-quantity-plus]');

          if (minusBtn) {
            const controls = minusBtn.closest('.quantity-selector-controls');
            const input = controls ? controls.querySelector('[data-cartitem-quantity]') : null;
            if (input) {
              const currentQty = parseInt(input.value) || 1;
              const newQty = Math.max(1, currentQty - 1);
              input.value = newQty;
              window.skipDOMCalculations = true;
              const inputEvent = new Event('input', { bubbles: true });
              input.dispatchEvent(inputEvent);
            }
          } else if (plusBtn) {
            const controls = plusBtn.closest('.quantity-selector-controls');
            const input = controls ? controls.querySelector('[data-cartitem-quantity]') : null;
            if (input) {
              const currentQty = parseInt(input.value) || 1;
              const newQty = currentQty + 1;
              input.value = newQty;
              window.skipDOMCalculations = true;
              const inputEvent = new Event('input', { bubbles: true });
              input.dispatchEvent(inputEvent);
            }
          }
        }, false);

        window._cartListenerAttached = true;
      }

      // Re-initialize when cart updates
      if (cartItemList) {
        const observer = new MutationObserver(function() {
          setTimeout(storeUnitPrices, 200);
        });

        observer.observe(cartItemList, {
          childList: true,
          subtree: true
        });
      }
    }
  }

  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initCartLineUpdater();
      // Fetch fresh cart data on page load to ensure subtotal is accurate
      setTimeout(function() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            if (window.updateAllSubtotals) {
              window.updateAllSubtotals(cart.total_price);
            }
            if (window.updateShippingBar) {
              window.updateShippingBar(cart.total_price);
            }
          })
          .catch(err => console.error('Error fetching cart on load:', err));
      }, 100);
    });
  } else {
    initCartLineUpdater();
    // Fetch fresh cart data on page load to ensure subtotal is accurate
    setTimeout(function() {
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          if (window.updateAllSubtotals) {
            window.updateAllSubtotals(cart.total_price);
          }
          if (window.updateShippingBar) {
            window.updateShippingBar(cart.total_price);
          }
        })
        .catch(err => console.error('Error fetching cart on load:', err));
    }, 100);
  }
})();
</script>

<script>
// Move shipping calculator based on screen size
(function() {
  function moveShippingCalculator() {
    var shippingCalc = document.getElementById('shipping-calc-container');
    if (!shippingCalc) return;

    var isMobile = window.innerWidth <= 768;
    var targetContainer = isMobile
      ? document.getElementById('mobile-shipping-target')
      : document.getElementById('desktop-shipping-target');

    if (targetContainer && shippingCalc.parentNode !== targetContainer) {
      targetContainer.appendChild(shippingCalc);
    }
  }

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', moveShippingCalculator);
  } else {
    moveShippingCalculator();
  }

  // Run on resize with debounce
  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(moveShippingCalculator, 250);
  });
})();
</script>

<script>
(function() {
  // Fix for shipping calculator button text concatenation issue
  document.addEventListener('DOMContentLoaded', function() {
    // Store original text values for each button
    var buttons = document.querySelectorAll('[data-cartshipping-toggle]');
    var buttonStates = new WeakMap();

    buttons.forEach(function(button) {
      // Store the two text states when page loads
      var text1 = button.textContent.trim();
      var text2 = button.getAttribute('data-cartshipping-toggle');

      buttonStates.set(button, {
        text1: text1,
        text2: text2,
        currentState: 1
      });

      // Remove any existing click handlers and add our own
      var newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);

      newButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var state = buttonStates.get(newButton);

        // Toggle state
        state.currentState = state.currentState === 1 ? 2 : 1;

        // Set the correct text based on state
        newButton.textContent = state.currentState === 1 ? state.text1 : state.text2;

        // Toggle the shipping calculator visibility
        var shippingCalc = document.querySelector('[data-cartshipping]');
        if (shippingCalc) {
          shippingCalc.classList.toggle('open');
        }
      });

      buttonStates.set(newButton, buttonStates.get(button));
    });
  });
})();
</script>

<script>
// Quick Add functionality for product recommendations
(function() {
  'use strict';

  function initQuickAdd() {
    // Handle click on Quick Add buttons
    document.addEventListener('click', function(e) {
      if (e.target.closest('.cart-recommendation-add-btn')) {
        e.preventDefault();

        const button = e.target.closest('.cart-recommendation-add-btn');
        const variantId = button.getAttribute('data-variant-id');

        if (!variantId) return;

        // Disable button and show loading state
        button.disabled = true;
        const originalHTML = button.innerHTML;

        // Prevent DOM calculations while updating
        window.skipDOMCalculations = true;

        // Add to cart via AJAX
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => response.json())
        .then(data => {
          button.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8L7 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

          // Fetch updated cart and update UI without reload
          setTimeout(function() {
            Promise.all([
              fetch('/cart.js').then(res => res.json()),
              fetch('/cart').then(res => res.text())
            ])
            .then(([cart, cartPageHtml]) => {
              // Update subtotal displays
              if (window.updateAllSubtotals) {
                window.updateAllSubtotals(cart.total_price);
              }

              // Update cart items list from fetched page
              var parser = new DOMParser();
              var newPage = parser.parseFromString(cartPageHtml, 'text/html');
              var newItemsList = newPage.querySelector('[data-cart-item-list]');
              if (newItemsList) {
                var currentItemsList = document.querySelector('[data-cart-item-list]');
                if (currentItemsList) {
                  currentItemsList.innerHTML = newItemsList.innerHTML;

                  // Re-initialize event listeners on new items
                  if (window.initCartLineUpdater) {
                    window.initCartLineUpdater();
                  }
                  if (window.initCartItemRemovalFixed) {
                    window.initCartItemRemovalFixed();
                  }
                }
              }

              // Update subtotal from fresh cart data (most reliable source)
              if (window.updateAllSubtotals) {
                window.updateAllSubtotals(cart.total_price);
              }

              // Dispatch cart updated event for shipping bar
              var event = new CustomEvent('cart:updated', { detail: { total_price: cart.total_price } });
              document.dispatchEvent(event);

              // Ensure shipping bar gets the correct total
              setTimeout(function() {
                if (window.updateShippingBar) {
                  window.updateShippingBar(cart.total_price);
                }
              }, 100);

              // Reset button after 1.5 seconds
              setTimeout(function() {
                button.innerHTML = originalHTML;
                button.disabled = false;
                window.skipDOMCalculations = false; // Re-enable DOM calculations
              }, 1500);
            })
            .catch(err => {
              console.error('Error updating cart display:', err);
              button.innerHTML = originalHTML;
              button.disabled = false;
              window.skipDOMCalculations = false; // Re-enable DOM calculations
            });
          }, 300);
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          button.disabled = false;
          window.skipDOMCalculations = false; // Re-enable DOM calculations

          // Reset button after 2 seconds
          setTimeout(function() {
            button.innerHTML = originalHTML;
          }, 2000);
        });
      }
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQuickAdd);
  } else {
    initQuickAdd();
  }
})();
</script>

<script>
// Real-time shipping progress bar updater
(function() {
  'use strict';

  const FREE_SHIPPING_THRESHOLD = 10000; // $100.00 in cents

  function formatMoney(cents) {
    const value = (cents / 100).toFixed(2);
    if (window.Shopify && window.Shopify.formatMoney) {
      const formatted = window.Shopify.formatMoney(cents, window.Shopify.money_format || '${{amount}}');
      // Strip any extra spaces for consistent formatting (no $ space issue)
      return formatted.replace(/\$\s+/, '$');
    }
    return '$' + value;
  }

  function updateShippingBar(cartTotalCents) {
    const shippingWrappers = document.querySelectorAll('.cart-shipping-progress-wrapper');

    if (shippingWrappers.length === 0) return;

    // Ensure cartTotalCents is a valid number
    const validTotal = Math.max(0, Math.floor(cartTotalCents || 0));
    const remainingCents = Math.max(0, FREE_SHIPPING_THRESHOLD - validTotal);
    let progressPercentage = (validTotal / FREE_SHIPPING_THRESHOLD) * 100;

    if (progressPercentage > 100) {
      progressPercentage = 100;
    }

    shippingWrappers.forEach(wrapper => {
      const progressBar = wrapper.querySelector('.cart-shipping-progress-bar, .cart-shipping-progress-bar-mobile');
      const progressText = wrapper.querySelector('.cart-shipping-progress-text, .cart-shipping-progress-text-mobile');
      const progressTitle = wrapper.querySelector('.cart-shipping-progress-title');
      const progressBarContainer = wrapper.querySelector('.cart-shipping-progress-bar-container');
      const progressHeader = wrapper.querySelector('.cart-shipping-progress-header');

      // Check if limit reached message exists
      let limitReachedMsg = wrapper.querySelector('.shipping-limit-reached-message');

      if (validTotal >= FREE_SHIPPING_THRESHOLD) {
        // Limit reached - show congratulations message ABOVE bar
        if (!limitReachedMsg) {
          limitReachedMsg = document.createElement('div');
          limitReachedMsg.className = 'shipping-limit-reached-message';
          limitReachedMsg.style.cssText = 'background: #dcfce7; border: 2px solid #22c55e; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; text-align: center;';
          limitReachedMsg.innerHTML = '<strong style="color: #166534; font-size: 16px;">🎉 Congratulations! Your order qualifies for free shipping</strong>';

          // Insert at the beginning of wrapper (ABOVE the bar)
          wrapper.insertBefore(limitReachedMsg, wrapper.firstChild);
        }

        // Update progress bar to 100%
        if (progressBar) {
          progressBar.style.width = '100%';
        }

        // Hide the header (contains title) and text when threshold reached
        if (progressHeader) {
          progressHeader.style.display = 'none';
        }
        if (progressText) {
          progressText.style.display = 'none';
        }

        // Keep the progress bar visible at 100%
        if (progressBarContainer) {
          progressBarContainer.style.display = 'block';
        }

      } else {
        // Below threshold - remove congratulations message if it exists
        if (limitReachedMsg) {
          limitReachedMsg.remove();
        }

        // Show header and text - use removeProperty to restore original display
        if (progressHeader) {
          progressHeader.style.removeProperty('display');
        }
        if (progressTitle) {
          progressTitle.textContent = 'You are almost at Free Shipping';
        }
        if (progressText) {
          progressText.style.removeProperty('display');
          // Display the EXACT remaining amount needed for free shipping
          progressText.innerHTML = 'You\'re only <span class="money">' + formatMoney(remainingCents) + '</span> away from free shipping';
        }

        // Update progress bar percentage
        if (progressBar) {
          progressBar.style.width = progressPercentage + '%';
        }

        // Ensure bar container is visible
        if (progressBarContainer) {
          progressBarContainer.style.removeProperty('display');
        }
      }
    });
  }

  // Make function globally accessible
  window.updateShippingBar = updateShippingBar;

  // Calculate cart total from DOM elements (for instant updates during typing)
  function calculateCartTotalFromDOM() {
    const cartItems = document.querySelectorAll('[data-cartitem]');
    let totalCents = 0;

    cartItems.forEach(cartItem => {
      // Get unit price from data attribute (prefer data-cartitem-price as it's the most reliable)
      let unitPrice = parseInt(cartItem.getAttribute('data-cartitem-price'));

      // Fallback to other attributes if data-cartitem-price is not set
      if (!unitPrice || isNaN(unitPrice)) {
        unitPrice = parseInt(cartItem.getAttribute('data-unit-price'));
      }

      // Final fallback: parse from the displayed price element
      if (!unitPrice || isNaN(unitPrice)) {
        const priceEl = cartItem.querySelector('[data-cartitem-total]');
        if (priceEl) {
          unitPrice = parseMoney(priceEl.textContent.trim());
          const qtyInput = cartItem.querySelector('[data-cartitem-quantity]');
          const qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
          unitPrice = qty > 0 ? Math.round(unitPrice / qty) : 0;
        }
      }

      unitPrice = unitPrice || 0;

      // Get quantity from input (unified selector)
      const qtyInput = cartItem.querySelector('[data-cartitem-quantity]');
      const qty = qtyInput ? Math.max(0, parseInt(qtyInput.value) || 0) : 1;

      if (unitPrice > 0 && qty > 0) {
        totalCents += unitPrice * qty;
      }
    });

    return Math.max(0, totalCents);
  }

  // Debounced API fetch for accurate server-side total (after cart update completes)
  let apiFetchTimeout = null;
  let lastFetchTime = 0;
  const MIN_FETCH_INTERVAL = 1000; // Don't fetch more than once per second

  function fetchAndUpdateFromAPI() {
    const now = Date.now();
    if (now - lastFetchTime < MIN_FETCH_INTERVAL) {
      // Schedule a delayed fetch instead
      if (apiFetchTimeout) clearTimeout(apiFetchTimeout);
      apiFetchTimeout = setTimeout(fetchAndUpdateFromAPI, MIN_FETCH_INTERVAL);
      return;
    }

    lastFetchTime = now;
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        updateShippingBar(cart.total_price);
      })
      .catch(error => console.error('Error fetching cart:', error));
  }

  // Listen for input events - use DOM calculation for instant feedback
  let inputDebounceTimer = null;
  document.addEventListener('input', function(e) {
    if (e.target.matches('[data-cartitem-quantity]') || e.target.matches('[data-quantity-input]')) {
      // Skip if server request is in progress
      if (window.skipDOMCalculations) return;

      // Clear any pending timers
      if (inputDebounceTimer) clearTimeout(inputDebounceTimer);

      // Debounce DOM calculation by 50ms for rapid typing
      inputDebounceTimer = setTimeout(function() {
        const calculatedTotal = calculateCartTotalFromDOM();
        updateShippingBar(calculatedTotal);
      }, 50);
    }
  });

  // Listen for change events - skip if cart line updater is handling it
  document.addEventListener('change', function(e) {
    if (e.target.matches('[data-cartitem-quantity]')) {
      // Skip if server request is in progress - cart line updater will handle the complete update
      if (window.skipDOMCalculations) return;

      // If skipDOMCalculations is off, this is a quantity change not handled by cart line updater
      // Cancel any scheduled API fetch since cart line updater will do it
      if (apiFetchTimeout) clearTimeout(apiFetchTimeout);
      apiFetchTimeout = null;
    }
  });

  // Listen for cart updates via custom event (from StaticCart.bundle.js after AJAX completes)
  document.addEventListener('cart:updated', function(e) {
    if (e.detail && e.detail.total_price !== undefined) {
      updateShippingBar(e.detail.total_price);
    }
  });

  // Initialize on page load
  function init() {
    // Calculate initial total from DOM
    const calculatedTotal = calculateCartTotalFromDOM();
    if (calculatedTotal > 0) {
      updateShippingBar(calculatedTotal);
    } else {
      // Fallback to parsing displayed total
      const cartTotalEl = document.querySelector('[data-cart-total]');
      if (cartTotalEl) {
        const cartTotalText = cartTotalEl.textContent.trim();
        const cartTotalCents = parseMoney(cartTotalText);
        updateShippingBar(cartTotalCents);
      } else {
        // Final fallback: fetch from server if DOM parsing fails
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            updateShippingBar(cart.total_price);
          })
          .catch(err => console.error('Error initializing shipping bar:', err));
      }
    }
  }

  function parseMoney(moneyString) {
    const cleaned = moneyString.replace(/[^\d.,]/g, '');
    let number;

    if (cleaned.indexOf(',') > cleaned.indexOf('.')) {
      number = parseFloat(cleaned.replace(/\./g, '').replace(',', '.'));
    } else {
      number = parseFloat(cleaned.replace(/,/g, ''));
    }

    return Math.round((number || 0) * 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

