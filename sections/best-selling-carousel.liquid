{%- comment -%}
  Best Selling Products Carousel
  Attractive, animated, fully responsive product carousel
{%- endcomment -%}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign products_to_show = section.settings.products_to_show -%}

<section class="best-selling-carousel best-selling-carousel--{{ section.id }}" data-best-selling-carousel>
  <div class="best-selling-carousel__container">
    {%- comment -%} Section Header {%- endcomment -%}
    <div class="best-selling-carousel__header">
      {% if section.settings.show_subtitle and section.settings.subtitle != blank %}
        <p class="best-selling-carousel__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.title_normal != blank or section.settings.title_highlight != blank %}
        <h2 class="best-selling-carousel__title">
          <span class="title-normal">{{ section.settings.title_normal }}</span>
          <span class="title-highlight">{{ section.settings.title_highlight }}</span>
        </h2>
      {% endif %}
    </div>

    {%- comment -%} Carousel Wrapper {%- endcomment -%}
    <div class="best-selling-carousel__wrapper">
      {% if section.settings.show_arrows %}
        <button class="best-selling-carousel__arrow best-selling-carousel__arrow--prev" aria-label="Previous" data-prev>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}

      <div class="best-selling-carousel__track-container">
        <div class="best-selling-carousel__track" data-track>
          {% for product in collection.products limit: products_to_show %}
            <div class="best-selling-carousel__card" data-card>
              <div class="best-selling-carousel__card-inner">
                {%- comment -%} Badges {%- endcomment -%}
                {%- assign current_variant = product.selected_or_first_available_variant -%}
                {%- assign variant_compare_price = current_variant.compare_at_price -%}
                {%- assign variant_price = current_variant.price -%}
                {%- assign has_discount = false -%}
                {%- if variant_compare_price != blank and variant_compare_price > variant_price -%}
                  {%- assign has_discount = true -%}
                {%- endif -%}
                <div class="best-selling-carousel__badges">
                  {% if product.available == false %}
                    <span class="badge badge--sold-out">Sold Out</span>
                  {% elsif has_discount %}
                    {% assign savings_amount = variant_compare_price | minus: variant_price %}
                    {% assign savings_percent = savings_amount | times: 100.0 | divided_by: variant_compare_price | round %}
                    <span class="badge badge--sale">Sale {{ savings_percent }}%</span>
                  {% endif %}

                  {%- comment -%} Calculate total inventory for low stock badge {%- endcomment -%}
                  {% assign total_inventory = 0 %}
                  {% for variant in product.variants %}
                    {% if variant.inventory_management == 'shopify' and variant.inventory_quantity %}
                      {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
                    {% endif %}
                  {% endfor %}

                  {%- comment -%} Low Stock Badge {%- endcomment -%}
                  {% if product.available and total_inventory > 0 and total_inventory <= 10 %}
                    <span class="badge badge--low-stock">Low Stock</span>
                  {% endif %}

                  {% if product.tags contains 'best-seller' or product.tags contains 'bestseller' or product.tags contains 'top-selling' %}
                    <span class="badge badge--bestseller">Best Seller</span>
                  {% elsif product.tags contains 'new' or product.tags contains 'new-arrival' %}
                    <span class="badge badge--new">New Arrival</span>
                  {% elsif product.tags contains 'trending' %}
                    <span class="badge badge--trending">Trending</span>
                  {% elsif product.tags contains 'popular' %}
                    <span class="badge badge--popular">Popular</span>
                  {% endif %}
                </div>

                {%- comment -%} Product Image {%- endcomment -%}
                <div class="best-selling-carousel__image-wrapper">
                  <a href="{{ product.url }}" class="best-selling-carousel__image-link">
                    {% if product.featured_image != blank %}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.featured_image.alt | escape | default: product.title }}"
                        loading="lazy"
                        class="best-selling-carousel__image best-selling-carousel__image--primary"
                      >
                      {%- assign hover_image = product.images[1] | default: product.featured_image -%}
                      <img
                        src="{{ hover_image | image_url: width: 400 }}"
                        alt="{{ hover_image.alt | escape | default: product.title }}"
                        loading="lazy"
                        class="best-selling-carousel__image best-selling-carousel__image--secondary"
                      >
                    {% else %}
                      <div class="best-selling-carousel__placeholder">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </a>

                  {%- comment -%} Quick Actions Overlay {%- endcomment -%}
                  <div class="best-selling-carousel__quick-actions">
                    <a href="{{ product.url }}" class="quick-action quick-action--view" title="Quick View">
                      <svg viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                    </a>
                  </div>
                </div>

                {%- comment -%} Product Info {%- endcomment -%}
                <div class="best-selling-carousel__info">
                  {%- comment -%} Reviews - Using Judge.me preview badge {%- endcomment -%}
                  <div class="best-selling-carousel__reviews">
                    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
                      {{ product.metafields.judgeme.badge }}
                    </div>
                  </div>

                  {%- comment -%} Product Title {%- endcomment -%}
                  <h3 class="best-selling-carousel__product-title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>

                  {%- comment -%} Price {%- endcomment -%}
                  <div class="best-selling-carousel__price">
                    {% if has_discount %}
                      <span class="price--compare">{{ variant_compare_price | money }}</span>
                    {% endif %}
                    <span class="price--current">{{ variant_price | money }}</span>
                  </div>

                  {%- comment -%} Check if product requires medical license {%- endcomment -%}
                  {% assign is_rx_product = false %}
                  {% assign customer_has_license = false %}
                  {% if product.tags contains 'rx' or product.tags contains 'prescription' or product.tags contains 'doctor-only' or product.tags contains 'rx-only' or product.tags contains 'medical-license' or product.type == 'Prescription' %}
                    {% assign is_rx_product = true %}
                  {% endif %}
                  {%- comment -%} Check if logged-in customer has medical license {%- endcomment -%}
                  {% if customer and customer.tags contains 'medical-license' or customer and customer.tags contains 'licensed' or customer and customer.tags contains 'verified-professional' %}
                    {% assign customer_has_license = true %}
                  {% endif %}

                  {%- comment -%} Variant Selectors {%- endcomment -%}
                  {% assign has_variants = false %}
                  {% unless product.has_only_default_variant %}
                    {% assign has_variants = true %}
                  {% endunless %}

                  {% if has_variants and product %}
                    <div class="best-selling-carousel__variants" data-product-variants-grid="{{ product.id }}">
                      {% for option in product.options_with_values %}
                        <div class="best-selling-carousel__option-field">
                          <label class="best-selling-carousel__option-label" for="bsc-option-{{ forloop.index0 }}-{{ product.id }}">
                            {{ option.name }}
                          </label>
                          <select
                            id="bsc-option-{{ forloop.index0 }}-{{ product.id }}"
                            class="best-selling-carousel__option-select"
                            data-product-option="{{ forloop.index0 }}"
                            data-product-id="{{ product.id }}"
                          >
                            {% for value in option.values %}
                              <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                                {{ value }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      {% endfor %}
                      <script type="application/json" data-product-id="{{ product.id }}" class="productitem--variant-data">
                        {
                          "id": {{ product.id | json }},
                          "options": {{ product.options | json }},
                          "variants": [
                            {% for variant in product.variants %}
                              {
                                "id": {{ variant.id | json }},
                                "title": {{ variant.title | json }},
                                "available": {{ variant.available | json }},
                                "optionValues": [
                                  {% for i in (1..3) %}
                                    {% assign option_key = 'option' | append: i %}
                                    {% assign option_value = variant[option_key] %}
                                    {{ option_value | json }}
                                    {% unless i == 3 %},{% endunless %}
                                  {% endfor %}
                                ]
                              }
                              {% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ]
                        }
                      </script>
                    </div>
                  {% endif %}

                  {%- comment -%} Buttons - Same structure as collection page with editable quantity {%- endcomment -%}
                  {% assign variant_inventory = product.selected_or_first_available_variant.inventory_quantity %}
                  {% assign has_inventory_tracking = false %}
                  {% if variant_inventory > 0 %}
                    {% assign has_inventory_tracking = true %}
                  {% endif %}

                  <div class="best-selling-carousel__buttons">
                    {% if product.available == false %}
                      <button class="btn btn--sold-out" disabled>
                        <span>Sold Out</span>
                      </button>
                    {% elsif is_rx_product and customer_has_license == false %}
                      <a href="{{ product.url }}" class="btn btn--rx-required">
                        <span>Medical License Required</span>
                      </a>
                    {% else %}
                      <div class="bsc-qty-selector" data-bsc-qty-selector>
                        <button type="button" class="bsc-qty-btn" data-bsc-qty-decrease>-</button>
                        <input
                          type="number"
                          class="bsc-qty-input"
                          data-bsc-qty-value
                          value="1"
                          min="1"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <button type="button" class="bsc-qty-btn" data-bsc-qty-increase>+</button>
                      </div>
                      <button
                        type="button"
                        class="btn btn--add-to-cart"
                        data-bsc-atc
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-grid-variants-enabled="{% if has_variants %}true{% else %}false{% endif %}"
                        {% if has_inventory_tracking %}data-inventory-quantity="{{ variant_inventory }}"{% endif %}
                      >
                        <span>Add to Cart</span>
                      </button>
                    {% endif %}
                  </div>
                </div>

                {%- comment -%} Hover Glow Effect {%- endcomment -%}
                <div class="best-selling-carousel__glow"></div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <button class="best-selling-carousel__arrow best-selling-carousel__arrow--next" aria-label="Next" data-next>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>

    {%- comment -%} View All Button {%- endcomment -%}
    {% if section.settings.show_view_all and collection != blank %}
      <div class="best-selling-carousel__footer">
        <a href="{{ collection.url }}" class="btn btn--view-all">
          <span>{{ section.settings.view_all_text }}</span>
          <svg viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .best-selling-carousel--{{ section.id }} {
    --bsc-primary-color: {{ section.settings.primary_color }};
    --bsc-secondary-color: {{ section.settings.secondary_color }};
    --bsc-text-color: {{ section.settings.text_color }};
    --bsc-card-gap: 15px;
    --bsc-card-border-radius: 12px;

    background: #ffffff;
    padding: 30px 0;
  }

  .best-selling-carousel__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header Styles */
  .best-selling-carousel__header {
    text-align: center;
    margin-bottom: 20px;
  }

  .best-selling-carousel__subtitle {
    font-size: 13px;
    color: var(--bsc-primary-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 8px;
    font-weight: 600;
  }

  .best-selling-carousel__title {
    font-size: 28px;
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
  }

  .best-selling-carousel__title .title-normal {
    color: var(--bsc-text-color);
  }

  .best-selling-carousel__title .title-highlight {
    color: var(--bsc-primary-color);
  }

  /* Carousel Wrapper */
  .best-selling-carousel__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .best-selling-carousel__track-container {
    overflow-x: auto;
    overflow-y: visible;
    flex: 1;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .best-selling-carousel__track-container::-webkit-scrollbar {
    display: none;
  }

  .best-selling-carousel__track {
    display: flex;
    gap: var(--bsc-card-gap);
  }

  /* Arrows */
  .best-selling-carousel__arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: white;
    color: #333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .best-selling-carousel__arrow:hover {
    border-color: var(--bsc-primary-color);
    color: var(--bsc-primary-color);
  }

  .best-selling-carousel__arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Arrow hidden state */
  .best-selling-carousel__arrow[style*="opacity: 0"] {
    visibility: hidden;
  }

  /* Product Cards - Smaller to fit 5-6 */
  .best-selling-carousel__card {
    flex: 0 0 220px;
    max-width: 220px;
    scroll-snap-align: start;
  }

  .best-selling-carousel__card-inner {
    position: relative;
    background: #fff;
    border-radius: var(--bsc-card-border-radius);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #eee;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .best-selling-carousel__card:hover .best-selling-carousel__card-inner {
    box-shadow: 0 4px 15px rgba(54, 123, 54, 0.25);
    border-color: var(--bsc-primary-color);
  }

  /* Glow Effect - Hidden */
  .best-selling-carousel__glow {
    display: none;
  }

  /* Badges */
  .best-selling-carousel__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .badge {
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    border-radius: 3px;
  }

  .badge--sale {
    background: var(--bsc-primary-color);
    color: white;
  }

  .badge--bestseller {
    background: #f39c12;
    color: white;
  }

  .badge--new {
    background: #9b59b6;
    color: white;
  }

  .badge--trending {
    background: #e74c3c;
    color: white;
  }

  .badge--popular {
    background: #3498db;
    color: white;
  }

  .badge--sold-out {
    background: #666;
    color: white;
  }

  /* Image */
  .best-selling-carousel__image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f9f9f9;
  }

  .best-selling-carousel__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .best-selling-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .best-selling-carousel__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .best-selling-carousel__card:hover .best-selling-carousel__image--primary {
    opacity: 0;
  }

  .best-selling-carousel__card:hover .best-selling-carousel__image--secondary {
    opacity: 1;
  }

  /* Quick Actions - Hidden for minimal design */
  .best-selling-carousel__quick-actions {
    display: none;
  }

  /* Product Info */
  .best-selling-carousel__info {
    padding: 15px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Reviews - Judge.me Widget */
  .best-selling-carousel__reviews {
    margin-bottom: 8px;
    min-height: 18px;
  }

  .best-selling-carousel__reviews .jdgm-preview-badge {
    font-size: 12px !important;
  }

  .best-selling-carousel__reviews .jdgm-prev-badge__stars {
    color: #ffc107 !important;
  }

  /* Product Title */
  .best-selling-carousel__product-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
    line-height: 1.4;
    min-height: calc(14px * 1.4 * 2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .best-selling-carousel__product-title a {
    color: #333;
    text-decoration: none;
  }

  .best-selling-carousel__card:hover .best-selling-carousel__product-title a {
    color: var(--bsc-primary-color);
  }

  /* Price */
  .best-selling-carousel__price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .price--current {
    font-size: 16px;
    font-weight: 700;
    color: var(--bsc-primary-color);
  }

  .price--compare {
    font-size: 13px;
    color: #999;
    text-decoration: line-through;
  }

  /* Variant Selectors */
  .best-selling-carousel__variants {
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .best-selling-carousel__option-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .best-selling-carousel__option-label {
    font-size: 12px;
    font-weight: 500;
    color: #333;
  }

  .best-selling-carousel__option-select {
    appearance: none;
    width: 100%;
    padding: 6px 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 12px;
    background: white url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8"><path fill="%23333" d="M1 1l5 5 5-5"/></svg>') no-repeat;
    background-position: right 8px center;
    background-repeat: no-repeat;
    padding-right: 24px;
    cursor: pointer;
  }

  .best-selling-carousel__option-select:disabled {
    background-color: #f5f5f5;
    cursor: not-allowed;
    opacity: 0.7;
    border-color: #ccc;
  }

  .best-selling-carousel__option-select option:disabled {
    color: #999;
    background: #f5f5f5;
  }

  /* Buttons - Grid Layout with Quantity Selector and Add to Cart */
  .best-selling-carousel__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: auto;
  }

  .best-selling-carousel__buttons .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 10px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    text-decoration: none;
    white-space: nowrap;
    width: 100%;
    height: 38px;
    box-sizing: border-box;
  }

  .btn--add-to-cart {
    background: var(--bsc-primary-color, #367b36) !important;
    color: white !important;
    width: 100%;
    display: inline-flex;
  }

  .btn--add-to-cart span {
    color: white !important;
  }

  .btn--add-to-cart:hover {
    background: var(--bsc-secondary-color, #4dbe4d) !important;
    color: white !important;
    transform: translateY(-1px);
  }

  .btn--sold-out {
    background: #e0e0e0;
    color: #888;
    cursor: not-allowed;
    grid-column: 1 / -1;
    height: 38px;
  }

  .btn--rx-required {
    background: #6c757d;
    color: white;
    grid-column: 1 / -1;
    width: 100%;
    height: 38px;
  }

  .btn--rx-required:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  /* Quantity Selector - Editable Input */
  .bsc-qty-selector {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
    width: 100%;
    height: 38px;
  }

  .bsc-qty-btn {
    width: 32px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #333333;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .bsc-qty-btn:hover:not(:disabled) {
    background: #e0e0e0;
  }

  .bsc-qty-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .bsc-qty-input {
    color: #333333;
    font-size: 12px;
    font-weight: 700;
    min-width: 30px;
    max-width: 50px;
    text-align: center;
    border: none;
    background: transparent;
    padding: 0 4px;
    height: 36px;
    -moz-appearance: textfield;
  }

  .bsc-qty-input::-webkit-outer-spin-button,
  .bsc-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .bsc-qty-input:focus {
    outline: none;
    background: #ffffff;
  }

  /* Footer */
  .best-selling-carousel__footer {
    text-align: center;
    margin-top: 20px;
  }

  .btn--view-all {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    padding: 12px 30px;
    background: var(--bsc-primary-color, #367b36) !important;
    color: white !important;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }

  .btn--view-all span {
    color: white !important;
  }

  .btn--view-all:hover {
    background: var(--bsc-secondary-color, #4dbe4d) !important;
    color: white !important;
    transform: translateY(-2px);
  }

  .btn--view-all svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
