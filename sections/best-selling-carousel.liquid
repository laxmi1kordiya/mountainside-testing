<script>
(function() {
  const section = document.querySelector('.best-selling-carousel--{{ section.id }}');
  if (!section) return;

  const track = section.querySelector('[data-track]');
  const trackContainer = section.querySelector('.best-selling-carousel__track-container');
  const prevBtn = section.querySelector('[data-prev]');
  const nextBtn = section.querySelector('[data-next]');
  const cards = section.querySelectorAll('[data-card]');

  if (!track || !trackContainer || cards.length === 0) return;

  // Prevent flash/glitch on load
  function initCarousel() {
    section.classList.remove('best-selling-carousel--loading');
  }

  // Handle back-forward cache
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      initCarousel();
    }
  });

  let cardWidth = cards[0].offsetWidth + {{ section.settings.card_gap }};

  function recalculateDimensions() {
    cardWidth = cards[0].offsetWidth + {{ section.settings.card_gap }};
    updateArrowVisibility();
  }

  // Update arrow visibility based on scroll position
  function updateArrowVisibility() {
    const scrollLeft = trackContainer.scrollLeft;
    const maxScroll = trackContainer.scrollWidth - trackContainer.offsetWidth;

    // Hide left arrow at start
    if (prevBtn) {
      if (scrollLeft <= 5) {
        prevBtn.style.opacity = '0';
        prevBtn.style.pointerEvents = 'none';
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.pointerEvents = 'auto';
      }
    }

    // Hide right arrow at end
    if (nextBtn) {
      if (scrollLeft >= maxScroll - 5) {
        nextBtn.style.opacity = '0';
        nextBtn.style.pointerEvents = 'none';
      } else {
        nextBtn.style.opacity = '1';
        nextBtn.style.pointerEvents = 'auto';
      }
    }
  }

  let autoplayInterval;
  let isHovering = false;
  let scrollTimeout;
  const autoplaySpeed = {{ section.settings.autoplay_speed }} * 1000;
  const enableAutoplay = {{ section.settings.enable_autoplay | json }};

  function scrollNext() {
    trackContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
  }

  function scrollPrev() {
    trackContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
  }

  function startAutoplay() {
    if (enableAutoplay && autoplaySpeed > 0 && !isHovering) {
      stopAutoplay(); // Clear any existing interval first
      autoplayInterval = setInterval(() => {
        // Check if at end, scroll to start
        if (trackContainer.scrollLeft + trackContainer.offsetWidth >= trackContainer.scrollWidth - 10) {
          trackContainer.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          scrollNext();
        }
      }, autoplaySpeed);
    }
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Pause on hover - functions
  function handleMouseEnter() {
    isHovering = true;
    stopAutoplay();
  }

  function handleMouseLeave() {
    isHovering = false;
    startAutoplay();
  }

  // Add hover listeners to section, track container, and track
  section.addEventListener('mouseenter', handleMouseEnter);
  section.addEventListener('mouseleave', handleMouseLeave);
  trackContainer.addEventListener('mouseenter', handleMouseEnter);
  trackContainer.addEventListener('mouseleave', handleMouseLeave);
  track.addEventListener('mouseenter', handleMouseEnter);
  track.addEventListener('mouseleave', handleMouseLeave);

  // Also pause on touch for mobile
  trackContainer.addEventListener('touchstart', () => {
    isHovering = true;
    stopAutoplay();
  }, { passive: true });

  trackContainer.addEventListener('touchend', () => {
    setTimeout(() => {
      isHovering = false;
      if (!isHovering) {
        startAutoplay();
      }
    }, 3000);
  }, { passive: true });

  // Arrow button clicks
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      scrollPrev();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      scrollNext();
    });
  }

  // Update arrow visibility on scroll
  trackContainer.addEventListener('scroll', () => {
    updateArrowVisibility();
  }, { passive: true });

  // Restart autoplay when user stops scrolling (only if not hovering)
  trackContainer.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      if (!isHovering) {
        startAutoplay();
      }
    }, 3000);
  }, { passive: true });

  // Initial arrow visibility check
  updateArrowVisibility();

  // Initialize autoplay
  startAutoplay();

  // Recalculate on resize
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(recalculateDimensions, 250);
  });

  // Initialize carousel immediately
  initCarousel();

  // =============================================
  // Best Selling Carousel - Quantity & Add to Cart
  // =============================================
  // All quantity selector functionality (increase, decrease, validation) and
  // Add to Cart functionality is now handled by the global product-card-buttons.js
  // which properly handles inventory limits and unlimited quantities

})();
</script>

