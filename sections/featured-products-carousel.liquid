<script>
(function() {
  const section = document.querySelector('.featured-carousel--{{ section.id }}');
  if (!section) return;

  const track = section.querySelector('[data-track]');
  const trackContainer = section.querySelector('.featured-carousel__track-container');
  const prevBtn = section.querySelector('[data-prev]');
  const nextBtn = section.querySelector('[data-next]');
  const cards = section.querySelectorAll('[data-card]');

  if (!track || !trackContainer || cards.length === 0) return;

  // Prevent flash/glitch on load
  function initCarousel() {
    section.classList.remove('featured-carousel--loading');
  }

  // Handle back-forward cache
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      initCarousel();
    }
  });

  let cardWidth = cards[0].offsetWidth + {{ section.settings.card_gap }};

  function recalculateDimensions() {
    cardWidth = cards[0].offsetWidth + {{ section.settings.card_gap }};
    updateArrowVisibility();
  }

  // Update arrow visibility based on scroll position
  function updateArrowVisibility() {
    const scrollLeft = trackContainer.scrollLeft;
    const maxScroll = trackContainer.scrollWidth - trackContainer.offsetWidth;

    // Hide left arrow at start
    if (prevBtn) {
      if (scrollLeft <= 5) {
        prevBtn.style.opacity = '0';
        prevBtn.style.pointerEvents = 'none';
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.pointerEvents = 'auto';
      }
    }

    // Hide right arrow at end
    if (nextBtn) {
      if (scrollLeft >= maxScroll - 5) {
        nextBtn.style.opacity = '0';
        nextBtn.style.pointerEvents = 'none';
      } else {
        nextBtn.style.opacity = '1';
        nextBtn.style.pointerEvents = 'auto';
      }
    }
  }

  let autoplayInterval;
  let isHovering = false;
  let scrollTimeout;
  const autoplaySpeed = {{ section.settings.autoplay_speed }} * 1000;
  const enableAutoplay = {{ section.settings.enable_autoplay | json }};

  function scrollNext() {
    trackContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
  }

  function scrollPrev() {
    trackContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
  }

  function startAutoplay() {
    if (enableAutoplay && autoplaySpeed > 0 && !isHovering) {
      stopAutoplay();
      autoplayInterval = setInterval(() => {
        if (trackContainer.scrollLeft + trackContainer.offsetWidth >= trackContainer.scrollWidth - 10) {
          trackContainer.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          scrollNext();
        }
      }, autoplaySpeed);
    }
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Pause on hover
  function handleMouseEnter() {
    isHovering = true;
    stopAutoplay();
  }

  function handleMouseLeave() {
    isHovering = false;
    startAutoplay();
  }

  // Add hover listeners to entire section and all interactive elements
  section.addEventListener('mouseenter', handleMouseEnter);
  section.addEventListener('mouseleave', handleMouseLeave);
  trackContainer.addEventListener('mouseenter', handleMouseEnter);
  trackContainer.addEventListener('mouseleave', handleMouseLeave);
  track.addEventListener('mouseenter', handleMouseEnter);
  track.addEventListener('mouseleave', handleMouseLeave);

  // Add hover listeners to all product cards
  cards.forEach(card => {
    card.addEventListener('mouseenter', handleMouseEnter);
    card.addEventListener('mouseleave', handleMouseLeave);
  });

  // Add hover listener to content block if it exists
  const contentBlock = section.querySelector('.featured-carousel__content-block');
  if (contentBlock) {
    contentBlock.addEventListener('mouseenter', handleMouseEnter);
    contentBlock.addEventListener('mouseleave', handleMouseLeave);
  }

  // Pause on touch for mobile - enhanced
  section.addEventListener('touchstart', () => {
    isHovering = true;
    stopAutoplay();
  }, { passive: true });

  trackContainer.addEventListener('touchstart', () => {
    isHovering = true;
    stopAutoplay();
  }, { passive: true });

  track.addEventListener('touchstart', () => {
    isHovering = true;
    stopAutoplay();
  }, { passive: true });

  // Restart autoplay after touch ends (with longer delay)
  section.addEventListener('touchend', () => {
    setTimeout(() => {
      isHovering = false;
      if (!isHovering) {
        startAutoplay();
      }
    }, 5000);
  }, { passive: true });

  trackContainer.addEventListener('touchend', () => {
    setTimeout(() => {
      isHovering = false;
      if (!isHovering) {
        startAutoplay();
      }
    }, 5000);
  }, { passive: true });

  // Arrow button clicks - also pause autoplay on click
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      stopAutoplay();
      scrollPrev();
      // Restart after delay
      setTimeout(() => {
        if (!isHovering) {
          startAutoplay();
        }
      }, 3000);
    });
    prevBtn.addEventListener('mouseenter', handleMouseEnter);
    prevBtn.addEventListener('mouseleave', handleMouseLeave);
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      stopAutoplay();
      scrollNext();
      // Restart after delay
      setTimeout(() => {
        if (!isHovering) {
          startAutoplay();
        }
      }, 3000);
    });
    nextBtn.addEventListener('mouseenter', handleMouseEnter);
    nextBtn.addEventListener('mouseleave', handleMouseLeave);
  }

  // Update arrow visibility on scroll
  trackContainer.addEventListener('scroll', () => {
    updateArrowVisibility();
  }, { passive: true });

  // Stop autoplay during scroll
  trackContainer.addEventListener('scroll', () => {
    stopAutoplay();
    clearTimeout(scrollTimeout);
  }, { passive: true });

  // Restart autoplay when user stops scrolling (only if not hovering)
  trackContainer.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      if (!isHovering) {
        startAutoplay();
      }
    }, 3000);
  }, { passive: true });

  // Initial arrow visibility check
  updateArrowVisibility();

  // Initialize autoplay
  startAutoplay();

  // Recalculate on resize
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(recalculateDimensions, 250);
  });

  // Initialize carousel immediately
  initCarousel();

  // Align content block height with product cards (DESKTOP ONLY)
  function alignContentBlockHeight() {
    // Only align on desktop (above 768px)
    if (window.innerWidth <= 768) return;

    const contentBlock = section.querySelector('.featured-carousel__content-block');
    const firstCard = section.querySelector('.featured-carousel__card');

    if (contentBlock && firstCard) {
      const cardHeight = firstCard.offsetHeight;
      // Set content block to match card height
      contentBlock.style.height = cardHeight + 'px';
      contentBlock.style.maxHeight = cardHeight + 'px';
    }
  }

  // Align on load
  setTimeout(alignContentBlockHeight, 100);

  // Realign on window resize
  let alignTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(alignTimeout);
    alignTimeout = setTimeout(alignContentBlockHeight, 250);
  });

  // Note: Quantity selector and Add to Cart functionality is handled by product-card-buttons.js
})();
</script>

