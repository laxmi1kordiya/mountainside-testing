{% comment %}
  Black Friday Banner Section
  Customizable promotional banner with diagonal design
{% endcomment %}

<style>
  .blackfriday-banner-wrapper {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    margin-left: {{ section.settings.margin_left }}px;
    margin-right: {{ section.settings.margin_right }}px;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left }}px;
    max-width: {{ section.settings.max_width }}%;
    margin-left: auto;
    margin-right: auto;
  }

  .blackfriday-banner {
    position: relative;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    min-height: {{ section.settings.banner_height }}px;
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .blackfriday-banner__left {
    position: relative;
    background: {{ section.settings.left_bg_color }};
    padding: {{ section.settings.left_padding_top }}px {{ section.settings.left_padding_right }}px {{ section.settings.left_padding_bottom }}px {{ section.settings.left_padding_left }}px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%);
    min-width: {{ section.settings.left_section_width }}%;
  }

  .blackfriday-banner__left::before {
    content: '';
    position: absolute;
    top: {{ section.settings.border_margin }}px;
    left: {{ section.settings.border_margin }}px;
    right: {{ section.settings.border_margin }}px;
    bottom: {{ section.settings.border_margin }}px;
    border: {{ section.settings.border_width }}px dashed {{ section.settings.border_color }};
    clip-path: polygon(0 0, 100% 0, calc(100% - {{ section.settings.border_margin }}px) 100%, 0 100%);
    pointer-events: none;
  }

  .blackfriday-banner__discount-label {
    color: {{ section.settings.discount_label_color }};
    font-size: {{ section.settings.discount_label_size }}px;
    font-weight: {{ section.settings.discount_label_weight }};
    letter-spacing: {{ section.settings.discount_label_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.discount_label_margin_bottom }}px;
    line-height: 1;
  }

  .blackfriday-banner__discount-value {
    color: {{ section.settings.discount_value_color }};
    font-size: {{ section.settings.discount_value_size }}px;
    font-weight: {{ section.settings.discount_value_weight }};
    line-height: 0.85;
    margin-bottom: {{ section.settings.discount_value_margin_bottom }}px;
  }

  .blackfriday-banner__discount-subtext {
    color: {{ section.settings.discount_subtext_color }};
    font-size: {{ section.settings.discount_subtext_size }}px;
    font-weight: {{ section.settings.discount_subtext_weight }};
    letter-spacing: {{ section.settings.discount_subtext_spacing }}px;
    text-transform: uppercase;
    line-height: 1;
  }

  .blackfriday-banner__right {
    position: relative;
    flex: 1;
    background: {{ section.settings.right_bg_color }};
    padding: {{ section.settings.right_padding_top }}px {{ section.settings.right_padding_right }}px {{ section.settings.right_padding_bottom }}px {{ section.settings.right_padding_left }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-left: -{{ section.settings.overlap_width }}px;
  }

  .blackfriday-banner__right::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: {{ section.settings.arrow_size }}px solid transparent;
    border-bottom: {{ section.settings.arrow_size }}px solid transparent;
    border-left: {{ section.settings.arrow_size }}px solid {{ section.settings.left_bg_color }};
  }

  .blackfriday-banner__limited-time {
    color: {{ section.settings.limited_time_color }};
    font-size: {{ section.settings.limited_time_size }}px;
    font-weight: {{ section.settings.limited_time_weight }};
    letter-spacing: {{ section.settings.limited_time_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.limited_time_margin_bottom }}px;
    line-height: 1;
  }

  .blackfriday-banner__title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: {{ section.settings.title_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
    line-height: 0.95;
  }

  .blackfriday-banner__title-black {
    color: {{ section.settings.title_black_color }};
  }

  .blackfriday-banner__title-friday {
    color: {{ section.settings.title_friday_color }};
  }

  .blackfriday-banner__subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    letter-spacing: {{ section.settings.subtitle_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
    line-height: 1.2;
  }

  .blackfriday-banner__code {
    color: {{ section.settings.code_color }};
    font-size: {{ section.settings.code_size }}px;
    font-weight: {{ section.settings.code_weight }};
    letter-spacing: {{ section.settings.code_spacing }}px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  @media screen and (max-width: 990px) {
    .blackfriday-banner__discount-label {
      font-size: {{ section.settings.discount_label_size | times: 0.8 }}px !important;
    }

    .blackfriday-banner__discount-value {
      font-size: {{ section.settings.discount_value_size | times: 0.75 }}px !important;
    }

    .blackfriday-banner__discount-subtext {
      font-size: {{ section.settings.discount_subtext_size | times: 0.85 }}px !important;
    }

    .blackfriday-banner__title {
      font-size: {{ section.settings.title_size | times: 0.75 }}px !important;
    }
  }  
  @media screen and (max-width: 768px) {
    .blackfriday-banner {
      flex-direction: column;
      min-height: auto;
    }

    .blackfriday-banner__left {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
      min-width: 100%;
      padding: 25px 30px !important;
    }

    .blackfriday-banner__left::before {
      clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
      margin: 10px !important;
    }

    .blackfriday-banner__right {
      margin-left: 0;
      width: 100%;
      padding: 25px 30px !important;
    }

    .blackfriday-banner__right::after {
      display: none;
    }

    .blackfriday-banner__discount-label {
      font-size: {{ section.settings.discount_label_size | times: 0.6 }}px !important;
      margin-bottom: 3px !important;
    }

    .blackfriday-banner__discount-value {
      font-size: {{ section.settings.discount_value_size | times: 0.5 }}px !important;
      margin-bottom: 3px !important;
    }

    .blackfriday-banner__discount-subtext {
      font-size: {{ section.settings.discount_subtext_size | times: 0.65 }}px !important;
    }

    .blackfriday-banner__limited-time {
      font-size: {{ section.settings.limited_time_size | times: 0.7 }}px !important;
      margin-bottom: 2px !important;
    }

    .blackfriday-banner__title {
      font-size: {{ section.settings.title_size | times: 0.5 }}px !important;
      margin-bottom: 5px !important;
    }

    .blackfriday-banner__subtitle {
      font-size: {{ section.settings.subtitle_size | times: 0.65 }}px !important;
      margin-bottom: 3px !important;
    }

    .blackfriday-banner__code {
      font-size: {{ section.settings.code_size | times: 0.65 }}px !important;
    }
  }
</style>

<div class="blackfriday-banner-wrapper">
  <div class="blackfriday-banner">
    <div class="blackfriday-banner__left">
      <div class="blackfriday-banner__discount-label">{{ section.settings.discount_label }}</div>
      <div class="blackfriday-banner__discount-value">{{ section.settings.discount_value }}</div>
      <div class="blackfriday-banner__discount-subtext">{{ section.settings.discount_subtext }}</div>
    </div>

    <div class="blackfriday-banner__right">
      <div class="blackfriday-banner__limited-time">{{ section.settings.limited_time_text }}</div>
      <h2 class="blackfriday-banner__title">
        <span class="blackfriday-banner__title-black">{{ section.settings.title_black }}</span>
        <span class="blackfriday-banner__title-friday">{{ section.settings.title_friday }}</span>
      </h2>
      <div class="blackfriday-banner__subtitle">{{ section.settings.subtitle }}</div>
      <div class="blackfriday-banner__code">{{ section.settings.code_text }}</div>
    </div>
  </div>
</div>

