{% if section.settings.show_related_searches %}
  {% render 'related-searches',
    heading: section.settings.heading,
    max_terms: section.settings.max_tags,
    source: 'auto',
    link_type: 'products',
    section_bg_color: section.settings.section_bg_color,
    title_color: section.settings.title_color,
    title_font_size: section.settings.title_font_size,
    tag_bg_color: section.settings.tag_bg_color,
    tag_text_color: section.settings.tag_text_color,
    tag_hover_bg_color: section.settings.tag_hover_bg_color,
    tag_hover_text_color: section.settings.tag_hover_text_color,
    tag_font_size: section.settings.tag_font_size,
    tag_border_radius: section.settings.tag_border_radius,
    tag_padding_vertical: section.settings.tag_padding_vertical,
    tag_padding_horizontal: section.settings.tag_padding_horizontal,
    tag_gap: section.settings.tag_gap,
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom
  %}
{% endif %}

{% schema %}
{
  "name": "Product Related Searches",
  "class": "product-related-searches--section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "show_related_searches",
      "label": "Show related searches",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "People Also Searched For"
    },
    {
      "type": "range",
      "id": "max_tags",
      "min": 5,
      "max": 30,
      "step": 1,
      "label": "Maximum products to show",
      "default": 9
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    },
    {
      "type": "header",
      "content": "Title Styling"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 22
    },
    {
      "type": "header",
      "content": "Tag Styling"
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag background color",
      "default": "#e8f5e9"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text color",
      "default": "#388138"
    },
    {
      "type": "color",
      "id": "tag_hover_bg_color",
      "label": "Tag hover background",
      "default": "#e8f5e9"
    },
    {
      "type": "color",
      "id": "tag_hover_text_color",
      "label": "Tag hover text color",
      "default": "#388138"
    },
    {
      "type": "range",
      "id": "tag_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tag font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tag_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tag border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "tag_padding_vertical",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tag vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "tag_padding_horizontal",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tag horizontal padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "tag_gap",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Gap between tags",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Product Related Searches"
    }
  ]
}
{% endschema %}
