<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-footer">
</script>

<footer role="contentinfo" aria-label="Footer">
  <section class="site-footer-wrapper">
    {% if section.blocks.size %}
      <div class="site-footer-item">
        <div class="site-footer-blocks column-count-{{ section.blocks.size }}">
          {% for block in section.blocks %}
            {% include 'footer-block' %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="site-footer-item">
      <div class="site-footer-information">
        <div class="site-footer-left">

          {% if linklists[section.settings.additional_menu].links != blank %}
            <nav
              class="site-footer-navigation"
              aria-label="{{ 'general.accessibility.nav_footer' | t }}"
            >
              {%
                include 'navlist',
                menu_list: linklists[section.settings.additional_menu].links,
                depth: 1,
                max_depth: 1
              %}
            </nav>
          {% endif %}

          <p class="site-footer-credits">
            {% assign year = 'now' | date: '%Y' %}
            {{ 'footer.general.copyright_html' | t: year: year, shop_name: shop.name }}
          </p>

          <p class="site-footer-credits">
            {{ powered_by_link }}
            
          </p>
        </div>

        <div class="site-footer-right">
          {% if section.settings.payment_icons and shop.enabled_payment_types.size > 0 %}
            <script src="https://static.legitscript.com/seals/641639.js"></script>
            <ul class="payment-icons">
              {% for type in shop.enabled_payment_types %}

              {% endfor %}
            </ul>
          {% endif %}

          {% if section.settings.show_social_icons %}
            <div class="footer-social-icons">
              {% if section.settings.social_facebook_url != blank %}
                <a href="{{ section.settings.social_facebook_url }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg aria-hidden="true" focusable="false" role="presentation" xmlns="https://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 28 28">
                    <path fill="currentColor" fill-rule="evenodd" d="M16.913 13.919h-2.17v7.907h-3.215V13.92H10v-2.794h1.528V9.316c0-1.294.601-3.316 3.245-3.316l2.38.01V8.72h-1.728c-.282 0-.68.145-.68.762v1.642h2.449l-.281 2.794z"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.social_instagram_url != blank %}
                <a href="{{ section.settings.social_instagram_url }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg aria-hidden="true" focusable="false" role="presentation" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 28 28">
                    <path fill="currentColor" fill-rule="evenodd" d="M11.114 7.042c-.745.034-1.254.152-1.7.326-.46.178-.85.418-1.24.807-.388.389-.628.78-.806 1.24-.174.445-.292.954-.326 1.699C7.008 11.86 7 12.099 7 14c0 1.901.008 2.14.042 2.886.034.745.152 1.254.326 1.7.178.46.418.85.807 1.24.389.388.78.628 1.24.807.445.173.954.29 1.699.325.747.034.985.042 2.886.042 1.901 0 2.14-.008 2.886-.042.745-.034 1.254-.152 1.7-.325.46-.18.85-.419 1.24-.808.388-.389.628-.78.807-1.24.173-.445.29-.954.325-1.699.034-.747.042-.985.042-2.886 0-1.901-.008-2.14-.042-2.886-.034-.745-.152-1.254-.325-1.7a3.432 3.432 0 0 0-.808-1.24c-.389-.388-.78-.628-1.24-.806-.445-.174-.954-.292-1.699-.326C16.14 7.008 15.901 7 14 7c-1.901 0-2.14.008-2.886.042zM10.405 14a3.595 3.595 0 1 0 7.19 0 3.595 3.595 0 0 0-7.19 0zM14 16.333a2.333 2.333 0 1 1 0-4.666 2.333 2.333 0 0 1 0 4.666zm4.9-6.323a.84.84 0 1 1-1.68 0 .84.84 0 0 1 1.68 0z"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.social_pinterest_url != blank %}
                <a href="{{ section.settings.social_pinterest_url }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Pinterest">
                  <svg aria-hidden="true" focusable="false" role="presentation" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 28 28">
                    <path fill="currentColor" fill-rule="evenodd" d="M13.914 6a7.913 7.913 0 0 0-2.885 15.281c-.07-.626-.132-1.586.028-2.27.144-.618.928-3.933.928-3.933s-.238-.475-.238-1.175c0-1.098.64-1.922 1.433-1.922.675 0 1 .507 1 1.115 0 .68-.43 1.694-.654 2.634-.188.789.395 1.43 1.172 1.43 1.405 0 2.487-1.482 2.487-3.622 0-1.894-1.361-3.219-3.306-3.219-2.251 0-3.571 1.689-3.571 3.434 0 .68.26 1.409.587 1.805.065.08.074.149.056.228-.06.25-.194.787-.22.897-.035.144-.114.176-.266.106-.987-.46-1.606-1.905-1.606-3.066 0-2.497 1.814-4.787 5.23-4.787 2.744 0 4.878 1.955 4.878 4.57 0 2.726-1.72 4.922-4.108 4.922-.801 0-1.555-.418-1.813-.91l-.495 1.88c-.178.688-.66 1.55-.983 2.075a7.914 7.914 0 0 0 10.258-7.56 7.914 7.914 0 0 0-7.913-7.912V6z"/>
                  </svg>
                </a>
              {% endif %}
            </div>

            <style>
              .site-footer-information {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: flex-start;
              }

              .site-footer-right {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: 20px;
                margin-top: -5px;
              }

              .footer-social-icons {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: {{ section.settings.social_icon_spacing }}px;
                margin-top: 0;
              }

              .footer-social-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: {{ section.settings.social_icon_size }}px;
                height: {{ section.settings.social_icon_size }}px;
                border-radius: {{ section.settings.social_icon_border_radius }}px;
                background-color: {{ section.settings.social_icon_bg_color }};
                color: {{ section.settings.social_icon_color }};
                transition: all 0.3s ease;
                text-decoration: none;
              }

              .footer-social-link svg {
                width: {{ section.settings.social_icon_svg_size }}px;
                height: {{ section.settings.social_icon_svg_size }}px;
              }

              .footer-social-link:hover {
                background-color: {{ section.settings.social_icon_hover_bg_color }};
                color: {{ section.settings.social_icon_hover_color }};
                transform: scale(1.1);
              }

              @media (max-width: 768px) {
                .site-footer-information {
                  flex-direction: column;
                }

                .site-footer-right {
                  width: 100%;
                  justify-content: center;
                  margin-top: 20px;
                }

                .footer-social-icons {
                  justify-content: center;
                }
              }
            </style>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "payment_icons",
      "label": "Show payment icons",
      "default": false
    },
    {
      "type": "header",
      "content": "Additional menu"
    },
    {
      "type": "link_list",
      "id": "additional_menu",
      "label": "Menu",
      "default": "footer",
      "info": "This menu won't show dropdown items."
    },
    {
      "type": "header",
      "content": "Social Media Icons"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Social Icons Styling"
    },
    {
      "type": "range",
      "id": "social_icon_size",
      "label": "Icon container size",
      "min": 30,
      "max": 60,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "social_icon_svg_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "social_icon_spacing",
      "label": "Space between icons",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "social_icon_border_radius",
      "label": "Icon border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 50,
      "unit": "px",
      "info": "Set to 50 for circle, 0 for square"
    },
    {
      "type": "color",
      "id": "social_icon_bg_color",
      "label": "Icon background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Icon color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Social Icons Hover Effects"
    },
    {
      "type": "color",
      "id": "social_icon_hover_bg_color",
      "label": "Hover background color",
      "default": "#1877f2"
    },
    {
      "type": "color",
      "id": "social_icon_hover_color",
      "label": "Hover icon color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu",
          "info": "This menu won't show dropdown items."
        }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Rich text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this section to welcome customers to your store, say a bit about your brand, or share news and seasonal promotions.</p>"
        }
      ]
    },
    {
      "type": "social_accounts",
      "name": "Social accounts",
      "limit": 1,
      "settings": [
       {
         "type": "paragraph",
         "content": "Social links can be managed in your General settings."
       }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Subscribe"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Invite customers to join your mailing list.</p>"
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "additional_menu": "footer"
    },
    "blocks": [
      {
        "type": "menu",
        "settings": {}
      },
      {
        "type": "newsletter",
        "settings": {}
      }
    ]
  }
}

{% endschema %}