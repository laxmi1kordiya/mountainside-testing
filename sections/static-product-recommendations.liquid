{% if section.settings.show_product_recommendations %}
  {% assign product_limit = section.settings.product_recommendations_limit | default: 10 %}

  <script
    type="application/json"
    data-section-type="static-product-recommendations"
    data-section-id="{{ section.id }}"
    data-section-data
  >
    {
      "settings": {
        "limit": {{ product_limit }}
      },
      "productId": {{ product.id | json }}
    }
  </script>

  <section
    class="product-recommendations--carousel product-recommendations--carousel-{{ section.id }}"
    data-html
    data-product-recommendations
    data-recommendations-carousel
  >
    {% if recommendations.products_count > 0 %}
      <div class="pr-carousel__container">
        <h2 class="product-section--title product-recommendations--title">
          {{ section.settings.product_recommendations_heading }}
        </h2>

        <div class="pr-carousel__wrapper">
          <button class="pr-carousel__arrow pr-carousel__arrow--prev" aria-label="Previous" data-pr-prev>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="pr-carousel__track-container" data-pr-track-container>
            <ul class="pr-carousel__track" data-pr-track>
              {% for product in recommendations.products limit: product_limit %}
                {%
                  include 'product-grid-item',
                  product: product,
                  eager_images: true
                %}
              {% endfor %}
            </ul>
          </div>

          <button class="pr-carousel__arrow pr-carousel__arrow--next" aria-label="Next" data-pr-next>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    {% endif %}
  </section>

  {% include 'quick-shop' %}

  <style>
    .product-recommendations--carousel-{{ section.id }} {
      padding: 40px 0;
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 0 25px;
    }

    .product-recommendations--carousel-{{ section.id }} .product-recommendations--title {
      margin-bottom: 24px;
    }

    /* Carousel wrapper - relative for arrow positioning */
    .product-recommendations--carousel-{{ section.id }} .pr-carousel__wrapper {
      position: relative;
    }

    /* Track container - horizontal scroll */
    .product-recommendations--carousel-{{ section.id }} .pr-carousel__track-container {
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 5px 0;
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__track-container::-webkit-scrollbar {
      display: none;
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
      display: flex;
      flex-wrap: nowrap;
      gap: 20px;
      list-style: none;
      margin: 0;
      padding: 0;
      align-items: stretch;
    }

    /* 5 cards: 5*(20%-16px) + 4*20px = 100% */
    .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
      flex: 0 0 calc(20% - 16px);
      width: auto;
      max-width: none;
      min-width: 0;
      margin: 0;
      scroll-snap-align: start;
      box-sizing: border-box;
    }

    /* === Card element alignment across all cards === */

    .product-recommendations--carousel-{{ section.id }} .productitem {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .product-recommendations--carousel-{{ section.id }} .productitem--image {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      flex-shrink: 0;
      height: auto;
    }

    .product-recommendations--carousel-{{ section.id }} .productitem--image img,
    .product-recommendations--carousel-{{ section.id }} .productitem--image .rimg-canvas {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .product-recommendations--carousel-{{ section.id }} .productitem--info {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      padding-top: 8px;
    }

    /* Price area - fixed height to align whether compare price exists or not */
    .product-recommendations--carousel-{{ section.id }} .productitem--price {
      min-height: 48px;
    }

    /* Title - fixed 2 lines */
    .product-recommendations--carousel-{{ section.id }} .productitem--title {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 2.8em;
    }

    /* Reviews - fixed height */
    .product-recommendations--carousel-{{ section.id }} .jdgm-widget.jdgm-preview-badge {
      min-height: 24px;
    }

    /* Hide description in carousel */
    .product-recommendations--carousel-{{ section.id }} .productitem--description {
      display: none;
    }

    .product-recommendations--carousel-{{ section.id }} .productitem--buttons {
      margin-top: auto;
      padding-top: 8px;
    }

    /* Prevent product cards from rising above arrows on hover/animation */
    .product-recommendations--carousel-{{ section.id }} .productgrid--item,
    .product-recommendations--carousel-{{ section.id }} .productgrid--item:hover,
    .product-recommendations--carousel-{{ section.id }} .productgrid--item.animating,
    .product-recommendations--carousel-{{ section.id }} .productgrid--item.visible {
      z-index: 1;
    }

    /* Arrows - always on top of product cards */
    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 500;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid #ddd;
      background: rgba(255, 255, 255, 0.95);
      color: #333;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow:hover {
      border-color: #367b36;
      color: #367b36;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow svg {
      width: 20px;
      height: 20px;
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow--prev {
      left: -5px;
    }

    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow--next {
      right: -5px;
    }

    /* Hidden state for arrows at scroll boundaries */
    .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow[data-hidden="true"] {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    /* === 1200px: Tighter gaps === */
    @media (max-width: 1200px) {
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
        gap: 18px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
        flex: 0 0 calc(20% - 14.4px);
      }
    }

    /* === 1024px: 4 cards, smaller arrows === */
    @media (max-width: 1024px) {
      .product-recommendations--carousel-{{ section.id }} {
        padding: 35px 0;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__container {
        padding: 0 15px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
        gap: 16px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
        flex: 0 0 calc(25% - 12px);
      }
      .product-recommendations--carousel-{{ section.id }} .product-recommendations--title {
        margin-bottom: 20px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price {
        min-height: 44px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow {
        width: 36px;
        height: 36px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow svg {
        width: 18px;
        height: 18px;
      }
    }

    /* === 768px: Tablet - 3 cards, no arrows === */
    @media (max-width: 768px) {
      .product-recommendations--carousel-{{ section.id }} {
        padding: 30px 0;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__container {
        padding: 0 10px;
      }
      .product-recommendations--carousel-{{ section.id }} .product-recommendations--title {
        font-size: 20px;
        margin-bottom: 16px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
        gap: 14px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
        flex: 0 0 calc(33.333% - 9.5px);
        width: auto;
        min-width: 0;
        max-width: none;
        margin: 0;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem {
        padding: 8px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--image-alternate,
      .product-recommendations--carousel-{{ section.id }} .productitem--image .rimg-canvas:first-child {
        display: none;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--info {
        padding-top: 6px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price {
        min-height: 40px;
        font-size: 13px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price .money {
        font-size: 13px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title {
        font-size: 13px;
        line-height: 1.35;
        margin-bottom: 4px;
        margin-top: 0;
        min-height: calc(13px * 1.35 * 2);
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title a {
        font-size: 13px;
      }
      .product-recommendations--carousel-{{ section.id }} .jdgm-widget.jdgm-preview-badge {
        min-height: 22px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--buttons {
        gap: 6px;
        padding-top: 6px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--atc-btn {
        font-size: 11px;
        padding: 8px 6px;
        min-height: 32px;
        height: auto;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-selector {
        height: 32px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-btn {
        width: 28px;
        height: 32px;
        font-size: 14px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-input {
        font-size: 11px;
        height: 30px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--sold-out-btn,
      .product-recommendations--carousel-{{ section.id }} .productitem--notify-me-btn {
        font-size: 11px;
        padding: 8px 6px;
        min-height: 32px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--license-msg {
        font-size: 11px;
        padding: 6px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--actions {
        display: none;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__arrow {
        display: none;
      }
    }

    /* === 480px: Mobile - compact fixed-width cards === */
    @media (max-width: 480px) {
      .product-recommendations--carousel-{{ section.id }} {
        padding: 20px 0;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__container {
        padding: 0 10px;
      }
      .product-recommendations--carousel-{{ section.id }} .product-recommendations--title {
        font-size: 18px;
        margin-bottom: 12px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
        gap: 12px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
        flex: 0 0 155px;
        width: 155px;
        min-width: 155px;
        max-width: 155px;
        margin: 0;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem {
        padding: 6px;
        min-height: 0;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--info {
        padding-top: 5px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price {
        min-height: 34px;
        font-size: 12px;
        margin-top: 2px;
        margin-bottom: 0;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price .money {
        font-size: 12px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title {
        font-size: 11px;
        line-height: 1.3;
        min-height: calc(11px * 1.3 * 2);
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title a {
        font-size: 11px;
      }
      .product-recommendations--carousel-{{ section.id }} .jdgm-widget.jdgm-preview-badge {
        min-height: 20px;
        font-size: 10px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--vendor {
        display: none;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--ratings {
        display: none;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--buttons {
        grid-template-columns: 1fr;
        gap: 4px;
        padding-top: 5px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--atc-btn {
        grid-column: 1 / -1;
        font-size: 9px;
        padding: 6px 4px;
        min-height: 28px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-selector {
        height: 28px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-btn {
        width: 26px;
        height: 28px;
        font-size: 13px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--qty-input {
        font-size: 10px;
        height: 26px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--sold-out-btn,
      .product-recommendations--carousel-{{ section.id }} .productitem--notify-me-btn {
        font-size: 9px;
        padding: 6px 4px;
        min-height: 28px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--license-msg {
        font-size: 9px;
        padding: 4px;
      }
    }

    /* === 380px: Small mobile === */
    @media (max-width: 380px) {
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track {
        gap: 10px;
      }
      .product-recommendations--carousel-{{ section.id }} .pr-carousel__track .productgrid--item {
        flex: 0 0 135px;
        width: 135px;
        min-width: 135px;
        max-width: 135px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title,
      .product-recommendations--carousel-{{ section.id }} .productitem--title a {
        font-size: 10px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--title {
        min-height: calc(10px * 1.3 * 2);
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price {
        min-height: 30px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--price .money {
        font-size: 11px;
      }
      .product-recommendations--carousel-{{ section.id }} .productitem--atc-btn {
        font-size: 8px;
      }
    }
  </style>

  <script>
  (function() {
    var sectionEl = document.querySelector('.product-recommendations--carousel-{{ section.id }}');
    if (!sectionEl) return;

    function initCarousel() {
      var trackContainer = sectionEl.querySelector('[data-pr-track-container]');
      var track = sectionEl.querySelector('[data-pr-track]');
      var prevBtn = sectionEl.querySelector('[data-pr-prev]');
      var nextBtn = sectionEl.querySelector('[data-pr-next]');

      if (!trackContainer || !track) return;

      function getCardWidth() {
        var card = track.querySelector('.productgrid--item');
        if (!card) return 220;
        return card.offsetWidth + 20;
      }

      function updateArrows() {
        var scrollLeft = trackContainer.scrollLeft;
        var maxScroll = trackContainer.scrollWidth - trackContainer.offsetWidth;

        // If all products fit in view, hide both arrows
        if (maxScroll <= 5) {
          if (prevBtn) prevBtn.setAttribute('data-hidden', 'true');
          if (nextBtn) nextBtn.setAttribute('data-hidden', 'true');
          return;
        }

        // Hide prev arrow when at the very start (first product visible)
        if (prevBtn) {
          prevBtn.setAttribute('data-hidden', scrollLeft <= 5 ? 'true' : 'false');
        }

        // Hide next arrow when at the very end (last product visible)
        if (nextBtn) {
          nextBtn.setAttribute('data-hidden', scrollLeft >= maxScroll - 5 ? 'true' : 'false');
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          trackContainer.scrollBy({ left: -getCardWidth() * 2, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          trackContainer.scrollBy({ left: getCardWidth() * 2, behavior: 'smooth' });
        });
      }

      trackContainer.addEventListener('scroll', updateArrows, { passive: true });

      // Initial arrow state
      updateArrows();

      // Recalculate on resize
      var resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(updateArrows, 250);
      });
    }

    // Initialize now if content already exists
    initCarousel();

    // Re-initialize when recommendations load dynamically via AJAX
    var sectionObserver = new MutationObserver(function() {
      setTimeout(initCarousel, 150);
    });
    sectionObserver.observe(sectionEl, { childList: true, subtree: true });
  })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product recommendations",
  "class": "product-recommendations--section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_recommendations",
      "label": "Show dynamic recommendations",
      "info": "Dynamic recommendations change and improve with time. [Learn more](https://help.shopify.com/en/themes/development/recommended-products)",
      "default": true
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "product_recommendations_limit",
      "label": "Number of products",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "presets":[
    {
      "name":"Static Product Recommendations"
    }
  ]
}

{% endschema %}