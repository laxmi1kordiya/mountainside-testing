    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-why-choose-us__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-why-choose-us__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-why-choose-us__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-why-choose-us__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-why-choose-us__grid-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-why-choose-us__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-why-choose-us__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-why-choose-us__card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_hover_shadow_y }}px {{ block.settings.card_hover_shadow_blur }}px {{ block.settings.card_hover_shadow_color }};
  }

  .ai-why-choose-us__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_margin }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-why-choose-us__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .ai-why-choose-us__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_margin }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-why-choose-us__card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-why-choose-us__nav-button-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-why-choose-us__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-why-choose-us-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-why-choose-us__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-why-choose-us__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-why-choose-us__grid-wrapper-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-why-choose-us__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(6, 85%);
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-snap-type: x mandatory;
    }

    .ai-why-choose-us__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-why-choose-us__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
      scroll-snap-align: start;
      min-width: 0;
    }

    .ai-why-choose-us__nav-button-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      background-color: {{ block.settings.card_background }};
      border: 2px solid {{ block.settings.card_border_color }};
      border-radius: 50%;
      cursor: pointer;
      z-index: 2;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .ai-why-choose-us__nav-button-{{ ai_gen_id }}:active {
      transform: translateY(-50%) scale(0.95);
    }

    .ai-why-choose-us__nav-button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
      color: {{ block.settings.icon_color }};
    }

    .ai-why-choose-us__nav-button--prev-{{ ai_gen_id }} {
      left: 0;
    }

    .ai-why-choose-us__nav-button--next-{{ ai_gen_id }} {
      right: 0;
    }

    .ai-why-choose-us__nav-button-{{ ai_gen_id }}.disabled {
      opacity: 0.3;
      pointer-events: none;
    }
  }
{% endstyle %}

