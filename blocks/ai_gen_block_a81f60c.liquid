<script>
  (function() {
    class WhyChooseUs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.grid = null;
        this.prevButton = null;
        this.nextButton = null;
      }

      connectedCallback() {
        this.grid = this.querySelector('.ai-why-choose-us__grid-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-why-choose-us__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-why-choose-us__nav-button--next-{{ ai_gen_id }}');

        if (this.grid && this.prevButton && this.nextButton) {
          this.setupNavigation();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scrollPrev());
        this.nextButton.addEventListener('click', () => this.scrollNext());
        this.grid.addEventListener('scroll', () => this.updateButtonStates());
        
        this.updateButtonStates();
      }

      scrollPrev() {
        const cardWidth = this.grid.querySelector('.ai-why-choose-us__card-{{ ai_gen_id }}').offsetWidth;
        const gap = parseInt(getComputedStyle(this.grid).gap);
        this.grid.scrollBy({
          left: -(cardWidth + gap),
          behavior: 'smooth'
        });
      }

      scrollNext() {
        const cardWidth = this.grid.querySelector('.ai-why-choose-us__card-{{ ai_gen_id }}').offsetWidth;
        const gap = parseInt(getComputedStyle(this.grid).gap);
        this.grid.scrollBy({
          left: cardWidth + gap,
          behavior: 'smooth'
        });
      }

      updateButtonStates() {
        const isAtStart = this.grid.scrollLeft <= 0;
        const isAtEnd = this.grid.scrollLeft + this.grid.clientWidth >= this.grid.scrollWidth - 1;

        if (isAtStart) {
          this.prevButton.classList.add('disabled');
        } else {
          this.prevButton.classList.remove('disabled');
        }

        if (isAtEnd) {
          this.nextButton.classList.add('disabled');
        } else {
          this.nextButton.classList.remove('disabled');
        }
      }
    }

    customElements.define('why-choose-us-{{ ai_gen_id }}', WhyChooseUs{{ ai_gen_id }});
  })();
</script>

