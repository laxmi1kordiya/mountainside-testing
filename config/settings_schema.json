          },
          {
            "value": "loox",
            "label": "Loox"
          },
          {
            "value": "opinew",
            "label": "Opinew"
          },
          {
            "value": "shopify_product_reviews",
            "label": "Shopify Product Reviews"
          },
          {
            "value": "stamped",
            "label": "Stamped.io"
          },
          {
            "value": "rivyo",
            "label": "Rivyo"
          }
        ]
      }
    ]
